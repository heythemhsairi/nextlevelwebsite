---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ReelModal from '../components/ReelModal.astro';
import PortalCalendar from '../components/PortalCalendar.astro';
import WorkGallery from '../components/react/WorkGallery';
import {
  hero, trust, workIntro, workItems, servicesIntro, services,
  portalIntro, foundersIntro, founders, finalCta, CTA, whatsappLink,
} from '../config';

/* homepage order interleaves the two collections (config already alternates) */
const galleryItems = workItems.map((w) => ({
  image: w.poster,
  text: w.title,
  category: w.client,
  href: `/work/${w.slug}`,
  client: w.client,
  title: w.title,
  categoryLabel: w.categoryAr,
  fullVideo: w.fullVideo,
  poster: w.poster,
}));
---
<Base
  title="Next Level — Media Production House في تونس"
  description="نخططو، نكتبوا، نصوّرو وننتجو content يخلّي خبرتك تبان كيما تستاهل. production house تونسية للأطباء، المحامين، الـ consultants والـ founders."
>
  <Nav current="/" />

  <main id="main-content">
    <!-- ═══ 01 · CINEMATIC HERO ═══ -->
    <section class="hero">
      <div class="hero__media" aria-hidden="true">
        <!-- No src in markup: site.js picks the right file per breakpoint so a
             phone never downloads the desktop hero. Reduced-motion / Save-Data
             users keep the static poster only. No-JS = poster. -->
        <video
          id="heroVideo"
          poster={hero.posterDesktop}
          data-src-desktop={hero.videoDesktop}
          data-src-mobile={hero.videoMobile}
          data-poster-desktop={hero.posterDesktop}
          data-poster-mobile={hero.posterMobile}
          muted
          loop
          playsinline
          preload="none"
        ></video>
      </div>
      <div class="hero__scrim" aria-hidden="true"></div>

      <div class="hero__frame container">
        <div class="hero__meta">
          <span class="meta"><span class="accent">●</span> REC — {hero.meta.label}</span>
          <span class="meta latin">{hero.meta.location}</span>
        </div>

        <div class="hero__body">
          <p class="hero__eyebrow meta">{hero.eyebrow}</p>
          <h1 class="h-hero">{hero.title}</h1>
          <p class="hero__sub lead">{hero.sub}</p>
          <!-- No separate showreel trigger: the hero film IS the reel (5s loop,
               no audio track). A silent 5-second modal would feel broken —
               restore the button when a real long-form showreel is supplied. -->
          <div class="hero__cta">
            <a href="/book" class="btn btn--solid btn--lg">{CTA.primary}</a>
            <a href="/work" class="btn btn--line btn--lg">{CTA.secondary}</a>
          </div>
        </div>
      </div>

      <!-- oversized decorative wordmark — the H1 above carries the message -->
      <p class="hero__wordmark latin" aria-hidden="true">NEXT LEVEL</p>
    </section>

    <!-- ═══ 02 · COMPACT TRUST (facts only) ═══ -->
    <section class="on-light section--sm trust">
      <div class="container">
        <div class="trust__grid">
          <p class="trust__note">{trust.note}</p>
          <ul class="trust__caps" role="list">
            {trust.capabilities.map((c, i) => (
              <li class="latin"><span class="trust__n latin">0{i + 1}</span>{c}</li>
            ))}
          </ul>
          <p class="trust__fields">
            {trust.fields.map((f, i) => (
              <>
                <span>{f}</span>{i < trust.fields.length - 1 && <i aria-hidden="true">·</i>}
              </>
            ))}
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ 03 · SELECTED WORK ═══ -->
    <section class="section work-sec" id="work">
      <div class="container">
        <div class="sindex"><b>03</b> Selected Work</div>
        <div class="work-sec__head reveal">
          <h2 class="h-display">{workIntro.title}</h2>
          <p class="lead">{workIntro.sub}</p>
        </div>
      </div>
      <div class="work-sec__stage reveal">
        <WorkGallery client:visible items={galleryItems} />
      </div>
      <div class="container work-sec__foot">
        <a href="/work" class="btn btn--line">{workIntro.cta} <span class="arrow" aria-hidden="true">←</span></a>
      </div>
    </section>

    <!-- ═══ 04 · TWO SERVICE PATHS (red band) ═══ -->
    <section class="on-red section svc">
      <div class="container">
        <div class="svc__head reveal">
          <h2 class="h-display">{servicesIntro.title}</h2>
          <p class="svc__sub">{servicesIntro.sub}</p>
        </div>

        <div class="svc__panels reveal-stagger">
          {services.map((s, i) => (
            <article class={`svc__panel ${i === 0 ? 'svc__panel--solid' : 'svc__panel--line'}`}>
              <span class="svc__index latin">{s.index}</span>
              <h3 class="svc__name latin">{s.name}</h3>
              <p class="svc__ar">{s.nameAr}</p>
              <p class="svc__copy">{s.copy}</p>
              <p class="svc__process latin" dir="ltr">{s.process.join(' → ')}</p>
              <p class="svc__who">{s.forWho}</p>
              <a href={`/services#${s.slug}`} class={`btn ${i === 0 ? 'btn--line svc__btn-ondark' : 'svc__btn-fill'}`}>
                {s.cta} <span class="arrow" aria-hidden="true">←</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ 05 · CLIENT PORTAL DEMO ═══ -->
    <section class="section portal-sec">
      <div class="container">
        <div class="sindex"><b>05</b> Client Portal</div>
        <div class="portal-sec__grid">
          <div class="portal-sec__head reveal">
            <h2 class="h-display">{portalIntro.title}</h2>
            <p class="lead">{portalIntro.sub}</p>
            <div class="portal-sec__soon">
              <p class="portal-sec__product latin">{portalIntro.productName}</p>
              <p class="portal-sec__badge latin">{portalIntro.soon}</p>
              <p class="portal-sec__soonline">{portalIntro.soonLine}</p>
              <a href="/portal" class="btn btn--line">شوف الـ Portal <span class="arrow" aria-hidden="true">←</span></a>
            </div>
          </div>
          <div class="reveal">
            <PortalCalendar />
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 06 · FOUNDERS TEASER ═══ -->
    <section class="on-light section founders-sec">
      <div class="container">
        <div class="sindex"><b>06</b> The Studio</div>
        <div class="founders-sec__grid">
          <h2 class="h-display reveal">{foundersIntro.title}</h2>
          <div class="founders-sec__people reveal-stagger">
            {founders.map((f) => (
              <div class="founder">
                {f.photo ? (
                  <img src={f.photo} alt={`صورة ${f.name}`} class="founder__photo" width="480" height="600" loading="lazy" />
                ) : (
                  <div class="founder__pending" role="img" aria-label={`صورة ${f.name} — قريبًا`}>
                    <span class="latin">Portrait<br />coming</span>
                  </div>
                )}
                <p class="founder__name latin">{f.name}</p>
                <p class="founder__role latin">{f.role}</p>
              </div>
            ))}
          </div>
        </div>
        <a href="/studio" class="btn btn--line founders-sec__cta">{foundersIntro.cta} <span class="arrow" aria-hidden="true">←</span></a>
      </div>
    </section>

    <!-- ═══ 07 · FINAL CTA ═══ -->
    <section class="section cta-sec">
      <div class="container reveal">
        <h2 class="h-display">{finalCta.title}</h2>
        <p class="lead">{finalCta.sub}</p>
        <div class="cta-sec__actions">
          <a href="/book" class="btn btn--solid btn--lg">{CTA.primary}</a>
          <a href={whatsappLink('السلام عليكم Next Level 👋 نحب نحكي معاكم.')} target="_blank" rel="noopener" class="btn btn--line btn--lg">{CTA.whatsapp}</a>
        </div>
      </div>
    </section>
  </main>

  <ReelModal />
  <Footer />
</Base>

<style>
  /* ═══ hero ═══ */
  .hero {
    position: relative; min-height: 100svh;
    display: flex; flex-direction: column; justify-content: flex-end;
    overflow: hidden; isolation: isolate;
  }
  .hero__media { position: absolute; inset: 0; z-index: -2; }
  .hero__media { background: var(--color-black); } /* no flash before poster/video */
  .hero__media video {
    width: 100%; height: 100%; object-fit: cover;
    /* focal point: keep the subject readable behind bottom-start copy */
    object-position: var(--hero-focal, 50% 38%);
  }
  @media (max-width: 760px) {
    .hero__media video { --hero-focal: 50% 30%; }
  }
  .hero__scrim {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top,
      rgba(10, 8, 8, 0.96) 6%, rgba(10, 8, 8, 0.55) 38%,
      rgba(10, 8, 8, 0.18) 62%, rgba(10, 8, 8, 0.5) 100%);
  }
  .hero__frame { width: 100%; padding-bottom: clamp(96px, 15vh, 170px); }
  .hero__meta {
    position: absolute; top: 96px; inset-inline: var(--gutter);
    display: flex; justify-content: space-between; gap: 12px;
  }
  .hero__body { max-width: 720px; }
  .hero__eyebrow { color: var(--white-70); }
  .hero__body h1 { margin-top: 16px; }
  .hero__sub { margin-top: 20px; color: var(--white-70); }
  .hero__cta { display: flex; align-items: center; gap: 12px; margin-top: 32px; flex-wrap: wrap; }

  /* decorative wordmark — clipped to hero bottom, behind content */
  .hero__wordmark {
    position: absolute; bottom: -0.14em; inset-inline-start: 0; z-index: -1;
    width: 100%;
    font-weight: 700; font-size: clamp(64px, 12.5vw, 190px);
    line-height: 1; letter-spacing: -0.02em; white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px var(--white-16);
    text-align: center;
    pointer-events: none; user-select: none;
    direction: ltr;
  }

  /* ═══ trust ═══ */
  .trust__grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-5); align-items: start; }
  .trust__note { font-weight: 700; font-size: var(--text-xl); line-height: 1.5; text-wrap: balance; }
  .trust__caps { display: flex; flex-wrap: wrap; gap: 0; border-top: 1px solid var(--black-16); }
  .trust__caps li {
    display: flex; align-items: baseline; gap: 10px;
    font-weight: 600; font-size: var(--text-base);
    padding: 16px 26px 16px 0; margin-inline-end: 26px;
  }
  .trust__n { font-size: var(--text-xs); color: var(--color-red); font-weight: 600; }
  .trust__fields { grid-column: 2; color: var(--black-64); font-size: var(--text-sm); display: flex; gap: 10px; flex-wrap: wrap; }
  .trust__fields i { font-style: normal; color: var(--color-red); }

  /* ═══ work ═══ */
  .work-sec__head { display: flex; flex-direction: column; gap: 16px; max-width: 640px; }
  .work-sec__stage { margin-top: var(--space-5); }
  .work-sec__foot { margin-top: var(--space-4); }

  /* ═══ services (red band) ═══ */
  .svc__head { max-width: 640px; }
  .svc__sub { margin-top: 16px; font-size: var(--text-lg); line-height: 1.7; color: rgba(244, 241, 238, 0.85); }
  .svc__panels {
    margin-top: var(--space-6);
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 20px; align-items: start;
  }
  .svc__panel {
    padding: clamp(28px, 4vw, 44px);
    border-radius: var(--radius-medium);
    display: flex; flex-direction: column; align-items: flex-start;
  }
  .svc__panel--solid { background: var(--color-black); color: var(--color-white); }
  .svc__panel--line { border: 1px solid rgba(10, 8, 8, 0.35); color: var(--color-white); margin-top: var(--space-5); }
  .svc__index { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.2em; opacity: 0.6; }
  .svc__name { margin-top: 14px; font-weight: 700; font-size: var(--text-xl); letter-spacing: -0.01em; }
  .svc__ar { color: inherit; opacity: 0.65; font-size: var(--text-sm); margin-top: 2px; }
  .svc__copy { margin-top: 18px; line-height: 1.8; }
  .svc__process { margin-top: 18px; font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.06em; opacity: 0.75; }
  .svc__panel--solid .svc__process { color: var(--color-red); opacity: 1; }
  .svc__who { margin-top: 10px; font-size: var(--text-sm); opacity: 0.65; }
  .svc__panel .btn { margin-top: 26px; }
  .svc__btn-ondark { border-color: var(--white-16); color: var(--color-white); }
  .svc__btn-ondark:hover { border-color: var(--color-red); color: var(--color-red); }
  .svc__btn-fill { background: var(--color-black); color: var(--color-white); }
  .svc__btn-fill:hover { background: #1d1717; }

  /* ═══ portal ═══ */
  .portal-sec__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: var(--space-5); align-items: start; }
  .portal-sec__head { display: flex; flex-direction: column; gap: 16px; }
  .portal-sec__soon { margin-top: var(--space-4); border-top: 1px solid var(--white-08); padding-top: var(--space-4); display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .portal-sec__product { font-weight: 600; font-size: var(--text-sm); }
  .portal-sec__badge {
    font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-red); border: 1px solid var(--red-40); border-radius: var(--radius-small);
    padding: 5px 12px;
  }
  .portal-sec__soonline { color: var(--white-70); font-size: var(--text-sm); max-width: 40ch; }
  .portal-sec__soon .btn { margin-top: 12px; }

  /* ═══ founders ═══ */
  .founders-sec__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); align-items: start; }
  .founders-sec__people { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .founder__photo, .founder__pending {
    aspect-ratio: 4 / 5; width: 100%; object-fit: cover;
    border-radius: var(--radius-medium);
  }
  .founder__pending {
    display: grid; place-items: center;
    background: var(--black-08); border: 1px dashed var(--black-16);
    color: var(--black-64); font-size: var(--text-xs); text-align: center;
    letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.8;
  }
  .founder__name { margin-top: 14px; font-weight: 700; font-size: var(--text-base); }
  .founder__role { color: var(--color-red); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.06em; }
  .founders-sec__cta { margin-top: var(--space-5); }

  /* ═══ final cta ═══ */
  .cta-sec { text-align: start; }
  .cta-sec .lead { margin-top: 16px; }
  .cta-sec__actions { display: flex; gap: 12px; margin-top: var(--space-4); flex-wrap: wrap; }

  /* ═══ responsive ═══ */
  @media (max-width: 1000px) {
    .portal-sec__grid, .founders-sec__grid { grid-template-columns: 1fr; }
    .svc__panels { grid-template-columns: 1fr; }
    .svc__panel--line { margin-top: 0; }
  }
  @media (max-width: 760px) {
    .trust__grid { grid-template-columns: 1fr; gap: var(--space-4); }
    .trust__fields { grid-column: auto; }
    .hero__meta { top: 88px; }
    .hero__frame { padding-bottom: clamp(72px, 12vh, 120px); }
    /* wordmark must never sit over the CTAs: shrink + fade further behind */
    .hero__wordmark { font-size: clamp(44px, 11vw, 72px); opacity: 0.5; }
  }
  @media (max-width: 560px) {
    .founders-sec__people { grid-template-columns: 1fr 1fr; gap: 12px; }
    .hero__cta .btn { flex: 1 1 100%; }
  }
</style>
