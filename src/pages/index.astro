---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ReelModal from '../components/ReelModal.astro';
import PortalCalendar from '../components/PortalCalendar.astro';
import WorkGallery from '../components/react/WorkGallery';
import { existsSync } from 'node:fs';
import {
  hero, introVideo, trust, workIntro, workItems, servicesIntro, services,
  portalIntro, foundersIntro, founders, finalCta, CTA, whatsappLink,
} from '../config';

/* homepage order interleaves the two collections (config already alternates) */
const galleryItems = workItems.map((w) => ({
  image: w.poster,
  text: w.title,
  category: w.client,
  href: `/work/${w.slug}`,
  client: w.client,
  title: w.title,
  categoryLabel: w.categoryAr,
  fullVideo: w.fullVideo,
  poster: w.poster,
  aspectRatio: w.aspectRatio,
}));

/* Intro Video playback activates automatically once the real file lands
   (build-time check — drop the mp4 in public/ and rebuild). */
const introVideoReady = existsSync(new URL(`../../public${introVideo.video}`, import.meta.url));
---
<Base
  title="Next Level — Media Production House في تونس"
  description="نخططو، نكتبوا، نصوّرو وننتجو content يخلّي خبرتك تبان كيما تستاهل. production house تونسية للأطباء، المحامين، الـ consultants والـ founders."
>
  <Nav current="/" />

  <main id="main-content">
    <!-- ═══ 01 · CINEMATIC HERO — plain 100svh section, native scrolling.
         (Smooth Scroll Hero + Electric Gaze removed by request; the approved
         asymmetric composition stays: wordmark lower-left, statement lower-right.) -->
    <section class="hero">
      <div class="hero__media" aria-hidden="true">
        <!-- No src in markup: site.js picks the right file per breakpoint so a
             phone never downloads the desktop hero. Reduced-motion / Save-Data
             users keep the static poster only. No-JS = poster. -->
        <video
          id="heroVideo"
          poster={hero.posterDesktop}
          data-src-desktop={hero.videoDesktop}
          data-src-mobile={hero.videoMobile}
          data-poster-desktop={hero.posterDesktop}
          data-poster-mobile={hero.posterMobile}
          muted
          loop
          playsinline
          preload="none"
        ></video>
      </div>
      <div class="hero__scrim" aria-hidden="true"></div>

      <div class="hero__meta">
        <span class="hero__meta-item"><b class="hero__dot">●</b> REC — {hero.meta.label}</span>
        <span class="hero__meta-item">{hero.meta.location}</span>
      </div>

      <!-- asymmetric editorial row: wordmark lower-left, summary lower-right -->
      <div class="hero__bottom">
        <p class="hero__wordmark" aria-hidden="true" dir="ltr">
          <span class="hero__wm-next">NEXT</span>
          <span class="hero__wm-level">LEVEL</span>
        </p>

        <div class="hero__summary">
          <i class="hero__rule" aria-hidden="true"></i>
          <p>{hero.copy}</p>
          <a href={hero.copyLinkHref} class="hero__link">
            <span class="hero__link-small latin" dir="ltr">{hero.copyLinkSmall}</span>
            <span class="latin" dir="ltr">{hero.copyLinkLabel}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══ 02 · COMPACT TRUST (facts only) ═══ -->
    <section class="on-light section--sm trust">
      <div class="container">
        <div class="trust__grid">
          <p class="trust__note">{trust.note}</p>
          <ul class="trust__caps" role="list">
            {trust.capabilities.map((c, i) => (
              <li class="latin"><span class="trust__n latin">0{i + 1}</span>{c}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══ 03 · INTRO VIDEO — one editorial composition: header row, wide film,
         text grid below (H1 8 cols · details 4 cols) ═══ -->
    <section class="ifilm" id="intro">
      <div class="ifilm__container">
        <header class="ifilm__head reveal">
          <span class="meta"><b class="accent">01</b> — INTRO VIDEO</span>
          <span class="meta latin">{introVideo.system}</span>
        </header>

        <figure class="ifilm__media reveal">
          <img
            src={introVideo.poster}
            alt=""
            width="1600" height="900"
            loading="lazy"
            class="ifilm__poster"
          />
          {introVideoReady ? (
            <button
              type="button"
              class="ifilm__play"
              data-reel={introVideo.video}
              data-reel-poster={introVideo.poster}
              data-reel-ar="landscape"
              aria-label={`${introVideo.play} — Intro Video، بالصوت`}
            >
              <span class="ifilm__play-circle" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
              <span class="ifilm__play-row" aria-hidden="true">
                {introVideo.play}
                <i class="ifilm__dot"></i>
                <span class="latin" dir="ltr">{introVideo.duration}</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 010 7"/></svg>
              </span>
            </button>
          ) : (
            <span class="ifilm__play ifilm__play--soon" aria-disabled="true">
              <span class="ifilm__play-circle" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
              <span class="ifilm__play-row">{introVideo.soon}</span>
            </span>
          )}
        </figure>

        <!-- the page's single semantic H1 — masked two-line reveal -->
        <h1 class="ifilm__title mask" dir="rtl">
          {introVideo.titleLines.map((line) => (
            <span class="ifilm__line"><i>{line}</i></span>
          ))}
        </h1>

        <div class="ifilm__aside reveal">
          <p class="ifilm__sub">{introVideo.sub}</p>
          <p class="ifilm__process meta latin" dir="ltr">Plan → Write → Shoot → Edit → Publish</p>
        </div>

        <a href="/services" class="ifilm__svc reveal">
          {introVideo.servicesLink} <span class="arrow" aria-hidden="true">←</span>
        </a>
      </div>
    </section>

    <!-- ═══ 04 · SELECTED WORK ═══ -->
    <section class="section work-sec" id="work">
      <div class="container">
        <div class="sindex"><b>04</b> Selected Work</div>
        <div class="work-sec__head reveal">
          <h2 class="h-display">{workIntro.title}</h2>
          <p class="lead">{workIntro.sub}</p>
        </div>
      </div>
      <div class="work-sec__stage reveal">
        <WorkGallery client:visible items={galleryItems} />
      </div>
      <div class="container work-sec__foot">
        <a href="/work" class="btn btn--line">{workIntro.cta} <span class="arrow" aria-hidden="true">←</span></a>
      </div>
    </section>

    <!-- ═══ 04 · TWO SERVICE PATHS (red band) ═══ -->
    <section class="on-red section svc">
      <div class="container">
        <div class="svc__head reveal">
          <h2 class="h-display">{servicesIntro.title}</h2>
          <p class="svc__sub">{servicesIntro.sub}</p>
        </div>

        <div class="svc__panels reveal-stagger">
          {services.map((s, i) => (
            <article class={`svc__panel ${i === 0 ? 'svc__panel--solid' : 'svc__panel--line'}`}>
              <span class="svc__index latin">{s.index}</span>
              <h3 class="svc__name latin">{s.name}</h3>
              <p class="svc__ar">{s.nameAr}</p>
              <p class="svc__copy">{s.copy}</p>
              <p class="svc__process latin" dir="ltr">{s.process.join(' → ')}</p>
              <p class="svc__who">{s.forWho}</p>
              <a href={`/services#${s.slug}`} class={`btn ${i === 0 ? 'btn--line svc__btn-ondark' : 'svc__btn-fill'}`}>
                {s.cta} <span class="arrow" aria-hidden="true">←</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ 05 · CLIENT PORTAL DEMO ═══ -->
    <section class="section portal-sec">
      <div class="container">
        <div class="sindex"><b>06</b> Client Portal</div>
        <div class="portal-sec__grid">
          <div class="portal-sec__head reveal">
            <h2 class="h-display">{portalIntro.title}</h2>
            <p class="lead">{portalIntro.sub}</p>
            <div class="portal-sec__soon">
              <p class="portal-sec__product latin">{portalIntro.productName}</p>
              <p class="portal-sec__badge latin">{portalIntro.soon}</p>
              <p class="portal-sec__soonline">{portalIntro.soonLine}</p>
              <a href="/portal" class="btn btn--line">شوف الـ Portal <span class="arrow" aria-hidden="true">←</span></a>
            </div>
          </div>
          <div class="reveal">
            <PortalCalendar />
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 06 · FOUNDERS TEASER ═══ -->
    <section class="on-light section founders-sec">
      <div class="container">
        <div class="sindex"><b>07</b> The Studio</div>
        <div class="founders-sec__grid">
          <div class="reveal">
            <h2 class="h-display">{foundersIntro.title}</h2>
            <p class="founders-sec__sub">{foundersIntro.sub}</p>
          </div>
          <!-- homepage stays short: the two founders only; the full team
               (executive + creative) lives on /studio#team -->
          <div class="founders-sec__people reveal-stagger">
            {founders.map((f) => (
              <div class="founder">
                {f.photo ? (
                  <img src={f.photo} alt={`صورة ${f.name}، ${f.role}`} class="founder__photo" width="480" height="600" loading="lazy" />
                ) : (
                  <div class="founder__pending" role="img" aria-label={`صورة ${f.name} — قريبًا`}>
                    <span class="founder__initials latin">{f.initials}</span>
                    <span class="founder__pending-label latin">Portrait pending</span>
                  </div>
                )}
                <p class="founder__name latin">{f.name}</p>
                <p class="founder__role latin">{f.role}</p>
              </div>
            ))}
          </div>
        </div>
        <a href={foundersIntro.ctaHref} class="btn btn--line founders-sec__cta">{foundersIntro.cta} <span class="arrow" aria-hidden="true">←</span></a>
      </div>
    </section>

    <!-- ═══ 07 · FINAL CTA ═══ -->
    <section class="section cta-sec">
      <div class="container reveal">
        <h2 class="h-display">{finalCta.title}</h2>
        <p class="lead">{finalCta.sub}</p>
        <div class="cta-sec__actions">
          <a href="/book" class="btn btn--solid btn--lg">{CTA.primary}</a>
          <a href={whatsappLink('السلام عليكم Next Level 👋 نحب نحكي معاكم.')} target="_blank" rel="noopener" class="btn btn--line btn--lg">{CTA.whatsapp}</a>
        </div>
      </div>
    </section>
  </main>

  <ReelModal />
  <Footer />
</Base>

<style>
  /* ═══ hero — plain section, approved asymmetric composition ═══ */
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-black);
  }
  .hero__media { position: absolute; inset: 0; z-index: 0; }
  .hero__media video {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
    background: var(--color-black);
  }
  .hero__scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to top,
      rgba(10, 8, 8, 0.78) 0%, rgba(10, 8, 8, 0.22) 26%,
      rgba(10, 8, 8, 0.08) 58%, rgba(10, 8, 8, 0.45) 100%);
  }

  .hero__meta {
    position: absolute; top: 96px; z-index: 2;
    inset-inline: clamp(20px, 4vw, 64px);
    display: flex; justify-content: space-between; gap: 12px;
  }
  .hero__meta-item {
    font-family: var(--font-latin); font-weight: 600; font-size: var(--text-xs);
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--white-55);
  }
  .hero__dot { color: var(--color-red); font-weight: 400; }

  /* asymmetric lower row: wordmark left · summary right (physical LTR) */
  .hero__bottom {
    position: absolute; z-index: 2;
    inset-inline: clamp(20px, 4vw, 64px);
    inset-block-end: clamp(24px, 4vw, 56px);
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(260px, 3fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: end;
    direction: ltr; /* physical composition only — Arabic content is dir=rtl inside */
  }

  .hero__wordmark {
    min-width: 0; margin: 0;
    font-family: var(--font-latin);
    font-size: clamp(72px, 9.5vw, 176px);
    font-weight: 900;
    line-height: 0.78;
    letter-spacing: -0.065em;
    white-space: nowrap;
    user-select: none; pointer-events: none;
    /* single entrance fade — once, CSS only (reduced-motion zeroes it globally) */
    animation: heroFade 0.7s var(--ease) both;
  }
  .hero__wm-next { color: var(--color-white); }
  .hero__wm-level { color: var(--color-red); margin-left: 0.2em; }

  .hero__summary {
    direction: rtl;
    justify-self: end;
    max-width: 22rem;
    min-width: 0;
    text-align: right;
    color: var(--color-white);
    animation: heroFade 0.7s var(--ease) 0.15s both;
  }
  .hero__rule { display: block; width: 34px; height: 2px; background: var(--color-red); margin-bottom: 14px; }
  .hero__summary p {
    margin: 0;
    font-family: var(--font-arabic);
    font-size: clamp(17px, 1.4vw, 23px);
    line-height: 1.65;
  }
  .hero__link {
    display: inline-flex; flex-direction: column; align-items: flex-start; gap: 4px;
    min-height: 44px; margin-top: 6px; justify-content: center;
    color: var(--white-70);
    transition: color 0.2s;
  }
  .hero__link:hover { color: var(--color-white); }
  .hero__link-small {
    font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    opacity: 0.65;
  }
  .hero__link > span:last-child { font-weight: 600; font-size: var(--text-sm); }

  @keyframes heroFade {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  /* tablet + mobile: the 7fr column can't hold the nowrap wordmark below
     ~900px — switch to the deliberate stacked composition */
  @media (max-width: 900px) {
    .hero__bottom { display: flex; flex-direction: column; align-items: stretch; gap: 18px; }
    .hero__wordmark { font-size: clamp(54px, 12vw, 104px); line-height: 0.84; }
    /* deliberate two-line stack — no accidental break */
    .hero__wm-next, .hero__wm-level { display: block; }
    .hero__wm-level { margin-left: 0; }
    .hero__summary { justify-self: auto; max-width: none; }
  }
  @media (max-width: 760px) {
    .hero__media video { object-position: 50% 30%; }
    .hero__meta { top: 88px; }
    .hero__wordmark { font-size: clamp(54px, 17vw, 88px); }
  }

  /* ═══ trust ═══ */
  .trust__grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-5); align-items: start; }
  .trust__note { font-weight: 700; font-size: var(--text-xl); line-height: 1.5; text-wrap: balance; }
  .trust__caps { display: flex; flex-wrap: wrap; gap: 0; border-top: 1px solid var(--black-16); }
  .trust__caps li {
    display: flex; align-items: baseline; gap: 10px;
    font-weight: 600; font-size: var(--text-base);
    padding: 16px 26px 16px 0; margin-inline-end: 26px;
  }
  .trust__n { font-size: var(--text-xs); color: var(--color-red); font-weight: 600; }

  /* ═══ intro film — one editorial grid composition ═══ */
  .ifilm {
    background: var(--color-black);
    padding-top: clamp(72px, 9vw, 140px);
    padding-bottom: clamp(88px, 11vw, 180px);
  }
  /* wider shared container: the film consumes the content width.
     The 78vh term keeps the TRUE 16:9 frame within the viewport on short
     screens by shrinking the whole composition (header stays edge-aligned). */
  .ifilm__container {
    width: min(100% - 40px, 1440px, calc(78vh * 16 / 9));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(260px, 4fr);
    grid-template-areas:
      'head  head'
      'media media'
      'title aside'
      'title cta';
    column-gap: clamp(32px, 5vw, 72px);
  }

  /* header row — labels share one baseline, aligned to the film edges */
  .ifilm__head {
    grid-area: head;
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
    padding-bottom: 14px; margin-bottom: 22px;
    border-bottom: 1px solid var(--white-10);
  }
  .ifilm__head .accent { font-weight: 700; }

  /* film frame — full content width, real 16:9 (height budget lives on the container) */
  .ifilm__media {
    grid-area: media;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: clamp(14px, 1.5vw, 24px);
    background: var(--color-black);
  }
  .ifilm__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* centered play control — circle + one-line label (title, duration, sound) */
  .ifilm__play {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px;
    width: 100%; border: none; background: rgba(10, 8, 8, 0.14);
    color: var(--color-white); cursor: pointer;
    font-family: var(--font-arabic);
    transition: background 0.25s var(--ease);
  }
  .ifilm__play:hover { background: rgba(10, 8, 8, 0.3); }
  .ifilm__play-circle {
    width: 84px; height: 84px; border-radius: 50%;
    background: var(--color-red); color: var(--color-white);
    display: grid; place-items: center;
    padding-inline-start: 6px; /* optical centering of the triangle */
    transition: transform 0.25s var(--ease);
  }
  .ifilm__play:hover .ifilm__play-circle { transform: scale(1.07); }
  .ifilm__play-row {
    display: inline-flex; align-items: center; gap: 10px;
    font-weight: 700; font-size: var(--text-sm);
    background: var(--black-72); border-radius: var(--radius-small);
    padding: 8px 16px; backdrop-filter: blur(6px);
  }
  .ifilm__dot { width: 4px; height: 4px; border-radius: 50%; background: var(--color-red); }
  .ifilm__play--soon { cursor: default; }
  .ifilm__play--soon .ifilm__play-circle { background: var(--black-72); border: 1px solid var(--white-16); }

  /* monumental H1 — its own controlled space, 8 columns, start-aligned (RTL right).
     Clipping fix: roomier line-height + padding for Thmanyah ascenders/descenders,
     min-width:0 so the grid can't squeeze it, and the reveal mask RELEASES after
     the animation (.done from site.js) so nothing stays clipped at rest. */
  .ifilm__title {
    grid-area: title;
    align-self: end;
    min-width: 0;
    margin-top: clamp(40px, 5vw, 72px);
    padding-block: 0.12em 0.18em;
    font-family: var(--font-arabic);
    font-weight: 700;
    font-size: clamp(52px, 6.2vw, 112px);
    /* Thmanyah's content box is ~1.21em — anything tighter bleeds glyph ink
       outside the line box (the measured clipping). 1.22 = zero bleed
       (measured content area = 1.21em). */
    line-height: 1.22;
    color: var(--color-white);
    text-wrap: balance;
    /* the 8-col grid track is the width constraint — a ch-based cap computes
       too narrow for Thmanyah and forced a third wrapped line */
    max-width: none;
    overflow: visible;
  }
  .ifilm__line { display: block; overflow: visible; }
  .ifilm__line i { display: block; font-style: normal; }
  /* reveal runs only with JS present (html.js) and clips only until .done */
  :global(html.js) .mask:not(.done) .ifilm__line { overflow: hidden; }
  :global(html.js) .ifilm__line i {
    transform: translateY(130%);
    transition: transform 0.85s var(--ease);
  }
  :global(html.js) .ifilm__line:nth-child(2) i { transition-delay: 0.12s; }
  :global(html.js) .mask.in .ifilm__line i { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .ifilm__line i { transform: none; }
    :global(html.js) .mask:not(.done) .ifilm__line { overflow: visible; }
  }

  /* details column — 4 columns, bottom-aligned with the headline baseline */
  .ifilm__aside {
    grid-area: aside;
    align-self: end;
    min-width: 0;
    margin-top: clamp(40px, 5vw, 72px);
    display: flex; flex-direction: column; gap: 18px;
  }
  .ifilm__sub { color: var(--white-70); font-size: var(--text-base); line-height: 1.85; max-width: 38ch; }
  .ifilm__process { font-size: 11px; }

  .ifilm__svc {
    grid-area: cta;
    justify-self: start;
    margin-top: 18px;
    display: inline-flex; align-items: center; gap: 10px;
    min-height: 44px;
    color: var(--color-white); font-weight: 700; font-size: var(--text-base);
    border-bottom: 2px solid var(--color-red);
    transition: color 0.2s;
  }
  .ifilm__svc:hover { color: var(--color-red); }

  /* ═══ work ═══ */
  .work-sec__head { display: flex; flex-direction: column; gap: 16px; max-width: 640px; }
  .work-sec__stage { margin-top: var(--space-5); }
  .work-sec__foot { margin-top: var(--space-4); }

  /* ═══ services (red band) ═══ */
  .svc__head { max-width: 640px; }
  .svc__sub { margin-top: 16px; font-size: var(--text-lg); line-height: 1.7; color: rgba(244, 241, 238, 0.85); }
  .svc__panels {
    margin-top: var(--space-6);
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 20px; align-items: start;
  }
  .svc__panel {
    padding: clamp(28px, 4vw, 44px);
    border-radius: var(--radius-medium);
    display: flex; flex-direction: column; align-items: flex-start;
  }
  .svc__panel--solid { background: var(--color-black); color: var(--color-white); }
  .svc__panel--line { border: 1px solid rgba(10, 8, 8, 0.35); color: var(--color-white); margin-top: var(--space-5); }
  .svc__index { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.2em; opacity: 0.6; }
  .svc__name { margin-top: 14px; font-weight: 700; font-size: var(--text-xl); letter-spacing: -0.01em; }
  .svc__ar { color: inherit; opacity: 0.65; font-size: var(--text-sm); margin-top: 2px; }
