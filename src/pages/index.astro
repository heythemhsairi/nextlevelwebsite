---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Modal from '../components/Modal.astro';
import BookCta from '../components/BookCta.astro';
import {
  site, hero, reframe, beforeAfter, system, cadence, audience,
  proof, work, tiers, faqs, CTA, whatsappLink,
} from '../config';

const waMsg = 'السلام عليكم Next Level 👋 نحب نحجز مكالمة خاصة.';
---
<Base>
  <Nav current="/" />

  <!-- ================= HERO ================= -->
  <section class="hero" id="hero">
    <div class="container hero__inner reveal">
      <div class="hero__text">
        <span class="eyebrow latin">{hero.eyebrow}</span>
        <h1 class="hero__title">{hero.titleAr}</h1>
        <p class="hero__en latin">{hero.titleEn}</p>
        <p class="lead hero__sub">{hero.sub}</p>
        <p class="hero__promise">إنت تحضر. <span class="accent">احنا نتكفّلو بالباقي.</span></p>
        <div class="hero__cta">
          <BookCta class="btn btn--solid btn--lg" label={CTA.primary} />
          <a href="#work" class="btn btn--ghost btn--lg">{CTA.secondary}</a>
        </div>
        <p class="hero__trust">{hero.trust}</p>
      </div>
    </div>
  </section>

  <!-- ================= REFRAME ================= -->
  <section class="section section--line">
    <div class="container reveal narrow">
      <span class="eyebrow">{reframe.eyebrow}</span>
      <h2 class="section__title big">إنت <span class="accent">أحسن</span> من الـ Content اللي يمثّلك</h2>
      <p class="lead">{reframe.body}</p>
      <div class="reframe">
        {reframe.points.map((p) => (
          <div class="reframe__row">
            <b class="latin">{p.k}</b>
            <span>{p.v}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= BEFORE / AFTER ================= -->
  <section class="section section--alt" id="work">
    <div class="container reveal">
      <span class="eyebrow">{beforeAfter.eyebrow}</span>
      <h2 class="section__title">الفرق موش الـ <span class="latin">camera</span> — الفرق هو الـ <span class="accent latin">production</span></h2>
      <p class="lead center">{beforeAfter.sub}</p>
      <div class="ba-wrap">
        <div class="ba" role="slider" tabindex="0" aria-label="مقارنة قبل و بعد الـ production"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
          <div class="ba__layer ba__after"><img src={beforeAfter.after} alt="بعد الـ production" width="1280" height="720" /></div>
          <div class="ba__layer ba__before"><img src={beforeAfter.before} alt="قبل — raw" width="1280" height="720" /></div>
          <span class="ba__tag ba__tag--b latin">Before</span>
          <span class="ba__tag ba__tag--a latin">After</span>
          <div class="ba__handle"><div class="ba__grip" aria-hidden="true">⟷</div></div>
        </div>
      </div>

      <!-- work gallery -->
      <div class="gallery">
        {work.map((w) => (
          <figure class="shot" role="button" tabindex="0" aria-label={`شوف ${w.tag}`}
                  data-video={w.tag} data-desc={`${w.tag} — Next Level.`}>
            <div class="shot__media">
              <video src={w.video} poster={w.poster} muted loop playsinline preload="none"></video>
              <div class="shot__play" aria-hidden="true"><span></span></div>
            </div>
            <figcaption><span class="tag latin">{w.tag}</span> {w.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= THE SYSTEM ================= -->
  <section class="section section--line">
    <div class="container reveal">
      <span class="eyebrow">{system.eyebrow}</span>
      <h2 class="section__title">Team واحد. <span class="accent">السلسلة الكاملة.</span></h2>
      <p class="lead">{system.sub}</p>
      <div class="chain">
        {system.steps.map((s) => (
          <div class="chain__step">
            <span class="chain__n latin">{s.n}</span>
            <h3 class="latin">{s.title}</h3>
            <p class="chain__ar">{s.ar}</p>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
      <p class="chain__foot">{system.footer}</p>
    </div>
  </section>

  <!-- ================= SYSTEM NOT ONE-OFFS ================= -->
  <section class="section section--alt">
    <div class="container reveal">
      <span class="eyebrow">{cadence.eyebrow}</span>
      <h2 class="section__title">الـ <span class="accent latin">Authority</span> موش فيديو وحدة — هي إنك تحضر كل شهر</h2>
      <p class="lead">{cadence.sub}</p>
      <div class="compare">
        <div class="compare__col compare__col--bad">
          <span class="compare__tag">{cadence.bad.tag}</span>
          <ul>{cadence.bad.items.map((t) => <li><i>—</i>{t}</li>)}</ul>
        </div>
        <div class="compare__col compare__col--good">
          <span class="compare__tag compare__tag--accent">{cadence.good.tag}</span>
          <ul>{cadence.good.items.map((t) => <li><i>✓</i>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= WHO IT'S FOR ================= -->
  <section class="section section--line">
    <div class="container reveal">
      <span class="eyebrow">{audience.eyebrow}</span>
      <h2 class="section__title">مصمّم للناس اللي الـ <span class="accent latin">reputation</span> متاعهم هي الـ business متاعهم</h2>
      <p class="lead">{audience.sub}</p>
      <div class="who">
        {audience.list.map((a) => (
          <div class="who__row">
            <b>{a.who}</b>
            <span>{a.why}</span>
          </div>
        ))}
      </div>
      <p class="who__note">{audience.note}</p>
    </div>
  </section>

  <!-- ================= PROOF ================= -->
  <section class="section section--alt">
    <div class="container reveal">
      <span class="eyebrow">{proof.eyebrow}</span>
      <h2 class="section__title">شنوّة يتبدّل كي الـ <span class="accent latin">production</span> يتكفّل بيه</h2>
      <p class="lead center">{proof.sub}</p>
      <div class="proof">
        {proof.items.map((p) => (
          <figure class="proof__card">
            <div class="proof__media"><img src={p.poster} alt="" width="640" height="480" loading="lazy" /></div>
            <blockquote>“{p.quote}”</blockquote>
            <figcaption>{p.who}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= OFFER / TIERS ================= -->
  <section class="section section--line" id="packs">
    <div class="container reveal">
      <span class="eyebrow">Packs</span>
      <h2 class="section__title">اختار مستوى الـ <span class="accent latin">Partnership</span></h2>
      <p class="lead center">موش feature list — مستويات شراكة. من fit للـ system الكامل.</p>
      <div class="tiers">
        {tiers.map((t) => (
          <div class={`tier ${t.featured ? 'tier--featured' : ''}`}>
            {t.featured && <span class="tier__badge latin">الأكثر اختياراً</span>}
            <h3 class="tier__name latin">{t.name}</h3>
            <p class="tier__ar">{t.ar}</p>
            <div class="tier__price latin">{t.price}<small>{t.per}</small></div>
            <ul class="tier__outcomes">
              {t.outcomes.map((o) => <li><i>✓</i>{o}</li>)}
            </ul>
            <p class="tier__best">{t.best}</p>
            {t.name === 'Signature'
              ? <a href={whatsappLink('السلام عليكم، نحب نقدّم طلب للـ Signature.')} target="_blank" rel="noopener" class="btn btn--ghost tier__cta">{t.cta} ←</a>
              : <BookCta class="btn btn--ghost tier__cta" label={`${t.cta} ←`} />}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= PROMISE BAND ================= -->
  <section class="promise-band">
    <div class="container reveal">
      <h2 class="promise-band__title">إنت تحضر. <span class="accent">احنا نتكفّلو بالباقي.</span></h2>
      <p class="promise-band__en latin">You show up. We handle the rest.</p>
      <BookCta class="btn btn--solid btn--lg" label={CTA.primary} />
    </div>
  </section>

  <!-- ================= FAQ ================= -->
  <section class="section section--line" id="faq">
    <div class="container reveal narrow">
      <span class="eyebrow">FAQ</span>
      <h2 class="section__title big">أسئلة</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary>{f.q}<i>+</i></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Modal />
  <Footer />
</Base>

<style>
  /* ---------- shared section helpers ---------- */
  .narrow { max-width: 820px; }
  .lead.center, .lead { margin-top: 22px; }
  .lead.center { margin-inline: auto; text-align: center; }
  .section__title { margin-top: 14px; }
  .section__title.big { font-size: clamp(38px, 6vw, 76px); }

  /* ---------- hero ---------- */
  .hero { padding-block: clamp(80px, 14vh, 180px) clamp(60px, 9vw, 120px); position: relative; }
  .hero__inner { max-width: 960px; }
  .hero__title { font-family: var(--font-ar); font-weight: 900; line-height: 1.1;
    font-size: clamp(38px, 6.4vw, 88px); margin-top: 26px; text-wrap: balance; }
  .hero__en { font-family: var(--font-display); font-weight: 700; color: var(--dim);
    font-size: clamp(16px, 2.4vw, 24px); margin-top: 16px; letter-spacing: -.01em; }
  .hero__sub { max-width: 640px; }
  .hero__promise { font-family: var(--font-ar); font-weight: 900; font-size: clamp(22px, 3vw, 34px); margin-top: 30px; }
  .hero__cta { display: flex; gap: 14px; margin-top: 36px; flex-wrap: wrap; }
  .hero__trust { color: var(--dim-2); font-size: 14px; margin-top: 30px; }

  /* ---------- reframe ---------- */
  .reframe { margin-top: 48px; display: flex; flex-direction: column; }
  .reframe__row { display: grid; grid-template-columns: 200px 1fr; gap: 28px; align-items: baseline;
    padding: 26px 0; border-top: 1px solid var(--line); }
  .reframe__row b { font-family: var(--font-display); font-weight: 700; font-size: 19px; color: var(--white); }
  .reframe__row span { color: var(--dim); font-size: 17px; }

  /* ---------- before/after ---------- */
  .ba-wrap { max-width: 900px; margin: clamp(40px,6vw,60px) auto 0; }
  .ba { position: relative; aspect-ratio: 16/9; overflow: hidden; cursor: ew-resize; user-select: none;
    border-radius: var(--radius); border: 1px solid var(--line-2); }
  .ba__layer { position: absolute; inset: 0; }
  .ba__layer img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ba__before { clip-path: inset(0 0 0 50%); }
  .ba__before img { filter: contrast(.95); }
  .ba__tag { position: absolute; top: 16px; font-family: var(--font-display); font-weight: 700; font-size: 12px;
    letter-spacing: .04em; padding: 6px 14px; border-radius: 999px; background: rgba(0,0,0,.55); backdrop-filter: blur(6px); }
  .ba__tag--b { inset-inline-start: 16px; color: var(--dim); }
  .ba__tag--a { inset-inline-end: 16px; color: #fff; background: var(--red); }
  .ba__handle { position: absolute; inset-block: 0; left: 50%; width: 2px; background: var(--white); transform: translateX(-50%); z-index: 3; }
  .ba__grip { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    width: 46px; height: 46px; border-radius: 50%; background: var(--red); color: #fff; display: grid; place-items: center; font-size: 16px; }

  /* ---------- gallery ---------- */
  .gallery { display: grid; grid-template-columns: repeat(5,1fr); gap: 14px; margin-top: clamp(44px,6vw,64px); }
  .shot { border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--line); background: var(--surface-2);
    transition: transform .4s var(--ease), border-color .4s; cursor: pointer; }
  .shot:hover { transform: translateY(var(--lift)); border-color: var(--line-2); }
  .shot__media { aspect-ratio: 9/16; position: relative; background: var(--fill-dark); overflow: hidden; }
  .shot__media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .shot__media::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to top, rgba(5,5,5,.6), transparent 55%); }
  .shot__play { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); z-index: 2;
    width: 46px; height: 46px; border-radius: 50%; background: var(--red); display: grid; place-items: center;
    transition: opacity .3s, transform .3s; }
  .shot__play span { width: 0; height: 0; border-style: solid; border-width: 8px 0 8px 13px;
    border-color: transparent transparent transparent #fff; margin-left: 4px; direction: ltr; }
  .shot:hover .shot__play { opacity: 0; }
  .shot figcaption { padding: 14px; font-size: 12.5px; color: var(--dim); }
  .tag { display: inline-block; background: var(--red); color: #fff; font-family: var(--font-display);
    font-weight: 700; font-size: 10.5px; padding: 3px 10px; border-radius: 999px; margin-bottom: 6px; }

  /* ---------- the chain / system ---------- */
  .chain { display: grid; grid-template-columns: repeat(5,1fr); gap: 0; margin-top: clamp(48px,6vw,68px);
    border-top: 1px solid var(--line); }
  .chain__step { padding: 34px 26px 34px 0; border-inline-start: 1px solid var(--line); padding-inline-start: 26px; }
  .chain__step:first-child { border-inline-start: none; padding-inline-start: 0; }
  .chain__n { font-family: var(--font-display); font-weight: 800; font-size: 15px; color: var(--red); letter-spacing: .1em; }
  .chain__step h3 { font-family: var(--font-display); font-weight: 700; font-size: 22px; margin: 14px 0 2px; }
  .chain__ar { color: var(--dim); font-size: 14px; margin-bottom: 10px; }
  .chain__step p:last-child { color: var(--dim); font-size: 14px; line-height: 1.6; }
  .chain__foot { margin-top: 40px; color: var(--white); font-size: clamp(17px,2.2vw,21px); max-width: 720px; font-weight: 600; }

  /* ---------- compare ---------- */
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: clamp(44px,6vw,64px); }
  .compare__col { padding: 36px 32px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--fill-card); }
  .compare__col--good { border-color: rgba(var(--red-rgb),.35); background: linear-gradient(180deg, rgba(var(--red-rgb),.06), var(--surface)); }
  .compare__tag { display: inline-block; font-family: var(--font-display); font-weight: 700; font-size: 12px;
    letter-spacing: .08em; text-transform: uppercase; padding: 6px 14px; border-radius: 999px; background: var(--surface-3); color: var(--dim); margin-bottom: 22px; }
  .compare__tag--accent { background: var(--red); color: #fff; }
  .compare__col ul { display: flex; flex-direction: column; gap: 14px; }
  .compare__col li { display: flex; gap: 12px; font-size: 16px; color: var(--dim); }
  .compare__col--good li { color: var(--white); }
  .compare__col li i { font-style: normal; font-weight: 800; color: var(--dim-2); }
  .compare__col--good li i { color: var(--red); }

  /* ---------- who ---------- */
  .who { margin-top: 46px; }
  .who__row { display: grid; grid-template-columns: 260px 1fr; gap: 28px; align-items: baseline;
    padding: 24px 0; border-top: 1px solid var(--line); }
  .who__row b { font-family: var(--font-ar); font-weight: 900; font-size: 20px; }
  .who__row span { color: var(--dim); }
  .who__note { margin-top: 38px; color: var(--dim); font-size: 16px; max-width: 640px; border-inline-start: 2px solid var(--red); padding-inline-start: 20px; }

  /* ---------- proof ---------- */
  .proof { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; margin-top: clamp(48px,6vw,64px); }
  .proof__card { border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface-2); overflow: hidden; padding-bottom: 24px; }
  .proof__media { aspect-ratio: 4/3; overflow: hidden; background: var(--fill-dark); }
  .proof__media img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.25); }
  .proof__card blockquote { padding: 22px 24px 8px; font-size: 17px; line-height: 1.6; }
  .proof__card figcaption { padding: 0 24px; color: var(--red); font-family: var(--font-display); font-weight: 600; font-size: 13px; }

  /* ---------- tiers ---------- */
  .tiers { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; margin-top: clamp(48px,6vw,68px); align-items: stretch; }
  .tier { padding: 40px 34px; border-radius: var(--radius-lg); border: 1px solid var(--line); background: var(--fill-card);
    display: flex; flex-direction: column; position: relative; transition: border-color .4s; }
  .tier:hover { border-color: var(--line-2); }
  .tier--featured { border-color: rgba(var(--red-rgb),.4); background: linear-gradient(180deg, rgba(var(--red-rgb),.07), var(--surface)); }
  .tier__badge { position: absolute; top: 18px; left: 50%; transform: translateX(-50%); background: var(--red); color: #fff;
    font-family: var(--font-display); font-weight: 700; font-size: 11px; letter-spacing: .04em; padding: 6px 16px; border-radius: 999px; white-space: nowrap; }
  .tier--featured { padding-top: 54px; }
  .tier__name { font-family: var(--font-display); font-weight: 800; font-size: 26px; }
  .tier__ar { color: var(--dim); font-size: 14.5px; margin: 8px 0 20px; min-height: 42px; }
  .tier__price { font-family: var(--font-display); font-weight: 800; font-size: 32px; padding-bottom: 22px;
    border-bottom: 1px solid var(--line); margin-bottom: 22px; }
  .tier__price small { font-family: var(--font-ar); font-weight: 400; font-size: 14px; color: var(--dim); margin-inline-start: 6px; }
  .tier--featured .tier__price { color: var(--red); }
  .tier__outcomes { display: flex; flex-direction: column; gap: 12px; margin-bottom: 22px; }
  .tier__outcomes li { display: flex; gap: 10px; color: var(--dim); font-size: 14.5px; }
  .tier__outcomes li i { font-style: normal; color: var(--red); font-weight: 800; }
  .tier__best { color: var(--dim-2); font-size: 13px; margin-bottom: 24px; margin-top: auto; }
  .tier__cta { width: 100%; }
  .tier--featured .tier__cta { background: var(--red); border-color: var(--red); color: #fff; }
  .tier--featured .tier__cta:hover { background: var(--red-hot); border-color: var(--red-hot); }

  /* ---------- promise band ---------- */
  .promise-band { padding-block: clamp(90px,12vw,160px); text-align: center; border-block: 1px solid var(--line);
    background: radial-gradient(70% 100% at 50% 0%, rgba(var(--red-rgb),.10), transparent 60%), var(--surface); }
  .promise-band__title { font-family: var(--font-ar); font-weight: 900; font-size: clamp(34px,6vw,76px); line-height: 1.1; text-wrap: balance; }
  .promise-band__en { font-family: var(--font-display); font-weight: 700; color: var(--dim); margin: 14px 0 34px; font-size: clamp(15px,2vw,20px); }

  /* ---------- faq ---------- */
  .faq { margin-top: clamp(44px,6vw,56px); display: flex; flex-direction: column; gap: 12px; }
  .faq__item { border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface-2); overflow: hidden; }
  .faq__item[open] { border-color: var(--line-2); }
  .faq__item summary { list-style: none; cursor: pointer; padding: 22px 24px; font-weight: 600; font-size: 17px;
    display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary i { font-style: normal; color: var(--red); font-size: 26px; transition: transform .3s var(--ease); }
  .faq__item[open] summary i { transform: rotate(45deg); }
  .faq__item p { color: var(--dim); padding: 0 24px 24px; line-height: 1.7; }

  /* ---------- responsive ---------- */
  @media (max-width: 900px) {
    .chain { grid-template-columns: 1fr 1fr; }
    .chain__step { border-inline-start: none; border-top: 1px solid var(--line); padding-inline-start: 0; padding-top: 28px; }
    .chain__step:first-child { border-top: none; }
    .gallery { grid-template-columns: repeat(2,1fr); }
    .proof, .tiers, .compare { grid-template-columns: 1fr; }
    .tier--featured { order: -1; }
    .reframe__row, .who__row { grid-template-columns: 1fr; gap: 8px; }
  }
  @media (max-width: 560px) {
    .gallery { grid-template-columns: 1fr 1fr; }
  }
</style>
