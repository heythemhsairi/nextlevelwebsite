---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Modal from '../components/Modal.astro';
import BookCta from '../components/BookCta.astro';
import {
  hero, intro, reframe, beforeAfter, system, cadence, audience,
  proof, work, tiers, faqs, CTA, whatsappLink,
} from '../config';

const [proofLead, ...proofRest] = proof.items;
---
<Base>
  <Nav current="/" />

  <!-- ═══════════════ HERO — cinematic, asymmetric ═══════════════ -->
  <section class="hero" id="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <span class="hero__ghost latin" aria-hidden="true">NEXT LEVEL</span>

    <div class="hero__grid">
      <!-- meta column -->
      <div class="hero__meta reveal">
        <span class="meta-label"><span class="accent">●</span> {hero.eyebrow}</span>
        <h1 class="hero__title">{hero.titleAr}</h1>
        <p class="hero__en latin">{hero.titleEn}</p>
        <p class="hero__promise">إنت تحضر. <span class="accent">احنا نتكفّلو بالباقي.</span></p>
        <div class="hero__cta">
          <BookCta class="btn btn--solid btn--lg" label={CTA.primary} />
          <button class="btn btn--ghost btn--lg" data-video="Next Level — Showreel" data-desc="الـ showreel الكامل متاعنا.">
            <span class="playdot" aria-hidden="true"></span> شوف الـ Reel
          </button>
        </div>
        <p class="hero__trust">{hero.trust}</p>
      </div>

      <!-- film frame -->
      <div class="hero__film reveal" data-parallax>
        <div class="hero__stage brackets" role="button" tabindex="0" aria-label="شغّل الـ Showreel"
             data-video="Next Level — Showreel" data-desc="الـ showreel الكامل متاعنا.">
          <video src={intro.video} poster={intro.poster} muted loop autoplay playsinline preload="metadata"></video>
          <div class="hero__vignette" aria-hidden="true"></div>
          <div class="hero__filmmeta">
            <span class="meta-label latin">● REC · Showreel</span>
            <span class="meta-label latin">00:00 / 01:30</span>
          </div>
          <div class="hero__play" aria-hidden="true"><span></span></div>
        </div>
      </div>
    </div>
    <p class="hero__caption container">{intro.caption} <span class="latin dim">{intro.captionEn}</span></p>
  </section>

  <!-- ═══════════════ 01 · REFRAME — quiet ═══════════════ -->
  <section class="zone zone--quiet zone--edge">
    <span class="zindex"><b>01</b> — المشكلة</span>
    <div class="container reframe-wrap reveal">
      <p class="overline">The Reframe</p>
      <h2 class="reframe-title">إنت <span class="accent">أحسن</span> من الـ Content اللي يمثّلك</h2>
      <p class="lead reframe-body">{reframe.body}</p>
      <div class="reframe">
        {reframe.points.map((p, i) => (
          <div class="reframe__row">
            <span class="reframe__n latin">0{i + 1}</span>
            <b class="latin">{p.k}</b>
            <span class="reframe__v">{p.v}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ 02 · BEFORE / AFTER — loud, full-bleed centerpiece ═══════════════ -->
  <section class="zone zone--loud zone--dark ba-zone" id="work">
    <span class="zindex"><b>02</b> — الفرق</span>
    <div class="container ba-head reveal">
      <p class="overline">The Difference</p>
      <h2 class="ba-title">الفرق موش الـ <span class="latin">camera</span><br />الفرق هو الـ <span class="accent latin">production</span></h2>
    </div>
    <div class="ba-stage bleed reveal" data-parallax>
      <div class="ba brackets" role="slider" tabindex="0" aria-label="مقارنة قبل و بعد الـ production"
           aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
        <div class="ba__layer ba__after"><img src={beforeAfter.after} alt="بعد الـ production" width="1920" height="1080" /></div>
        <div class="ba__layer ba__before"><img src={beforeAfter.before} alt="قبل — raw" width="1920" height="1080" /></div>
        <span class="ba__tag ba__tag--b latin">Before · Raw</span>
        <span class="ba__tag ba__tag--a latin">After · Next Level</span>
        <div class="ba__handle"><div class="ba__grip" aria-hidden="true">⟷</div></div>
      </div>
    </div>
    <p class="container ba-sub reveal">{beforeAfter.sub}</p>
  </section>

  <!-- ═══════════════ 03 · THE SYSTEM — pinned, sequential ═══════════════ -->
  <section class="zone system-zone watermark" data-word="SYSTEM" id="system">
    <span class="zindex"><b>03</b> — الـ System</span>
    <div class="system-pin">
      <div class="container system-grid">
        <div class="system-head reveal">
          <p class="overline">The System</p>
          <h2 class="system-title">Team واحد.<br /><span class="accent">السلسلة الكاملة.</span></h2>
          <p class="lead">{system.sub}</p>
          <p class="system-foot">{system.footer}</p>
        </div>
        <ol class="system-steps">
          {system.steps.map((s, i) => (
            <li class="sstep" data-step={i}>
              <span class="sstep__n latin">{s.n}</span>
              <div class="sstep__body">
                <h3 class="latin">{s.title} <span class="sstep__ar">{s.ar}</span></h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 04 · CADENCE — quiet, asymmetric ═══════════════ -->
  <section class="zone zone--quiet zone--edge">
    <span class="zindex"><b>04</b> — Consistency</span>
    <div class="container cadence-grid reveal">
      <div class="cadence-head">
        <p class="overline">System, not one-offs</p>
        <h2 class="cadence-title">الـ <span class="accent latin">Authority</span> موش فيديو وحدة — هي إنك تحضر كل شهر</h2>
        <p class="lead">{cadence.sub}</p>
      </div>
      <div class="compare">
        <div class="compare__col compare__col--bad">
          <span class="compare__tag">{cadence.bad.tag}</span>
          <ul>{cadence.bad.items.map((t) => <li><i>—</i>{t}</li>)}</ul>
        </div>
        <div class="compare__col compare__col--good">
          <span class="compare__tag compare__tag--accent">{cadence.good.tag}</span>
          <ul>{cadence.good.items.map((t) => <li><i>✓</i>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 05 · WHO — quiet, editorial ═══════════════ -->
  <section class="zone zone--quiet zone--edge">
    <span class="zindex"><b>05</b> — لِشكون</span>
    <div class="container reveal">
      <p class="overline">Who it's for</p>
      <h2 class="who-title">مصمّم للناس اللي الـ <span class="accent latin">reputation</span> متاعهم هي الـ business متاعهم</h2>
      <div class="who">
        {audience.list.map((a, i) => (
          <div class="who__row">
            <span class="who__n latin">0{i + 1}</span>
            <b>{a.who}</b>
            <span class="who__why">{a.why}</span>
          </div>
        ))}
      </div>
      <p class="who__note">{audience.note}</p>
    </div>
  </section>

  <!-- ═══════════════ 06 · PROOF — loud, asymmetric editorial ═══════════════ -->
  <section class="zone zone--loud zone--dark proof-zone">
    <span class="zindex"><b>06</b> — Proof</span>
    <div class="container proof-head reveal">
      <p class="overline">Proof</p>
      <h2 class="proof-title">شنوّة يتبدّل كي الـ <span class="accent latin">production</span> يتكفّل بيه</h2>
    </div>
    <div class="container proof-grid reveal">
      <!-- lead pulled-quote -->
      <figure class="proof-lead">
        <div class="proof-lead__media"><img src={proofLead.poster} alt="" width="720" height="900" loading="lazy" /></div>
        <blockquote>“{proofLead.quote}”</blockquote>
        <figcaption>{proofLead.who}</figcaption>
      </figure>
      <!-- supporting quotes + clips -->
      <div class="proof-side">
        {proofRest.map((p) => (
          <figure class="proof-quote">
            <blockquote>“{p.quote}”</blockquote>
            <figcaption>{p.who}</figcaption>
          </figure>
        ))}
        <div class="proof-clips">
          {work.slice(0, 3).map((w) => (
            <figure class="shot" role="button" tabindex="0" aria-label={`شوف ${w.tag}`}
                    data-video={w.tag} data-desc={`${w.tag} — Next Level.`}>
              <div class="shot__media">
                <video src={w.video} poster={w.poster} muted loop playsinline preload="none"></video>
                <div class="shot__play" aria-hidden="true"><span></span></div>
              </div>
              <figcaption><span class="tag latin">{w.tag}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 07 · TIERS — medium, hierarchy ═══════════════ -->
  <section class="zone zone--medium zone--edge" id="packs">
    <span class="zindex"><b>07</b> — Packs</span>
    <div class="container reveal">
      <p class="overline">Partnership</p>
      <h2 class="tiers-title">اختار مستوى الـ <span class="accent latin">Partnership</span></h2>
      <p class="lead center">موش feature list — مستويات شراكة. من fit للـ system الكامل.</p>
      <div class="tiers">
        {tiers.map((t) => (
          <div class={`tier ${t.featured ? 'tier--featured' : ''}`}>
            {t.featured && <span class="tier__badge latin">الأكثر اختياراً</span>}
            <h3 class="tier__name latin">{t.name}</h3>
            <p class="tier__ar">{t.ar}</p>
            <div class="tier__price latin">{t.price}<small>{t.per}</small></div>
            <ul class="tier__outcomes">
              {t.outcomes.map((o) => <li><i>✓</i>{o}</li>)}
            </ul>
            <p class="tier__best">{t.best}</p>
            {t.name === 'Signature'
              ? <a href={whatsappLink('السلام عليكم، نحب نقدّم طلب للـ Signature.')} target="_blank" rel="noopener" class="btn btn--ghost tier__cta">{t.cta} ←</a>
              : <BookCta class="btn btn--ghost tier__cta" label={`${t.cta} ←`} />}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ 08 · PROMISE — the climax ═══════════════ -->
  <section class="promise watermark" data-word="AUTHORITY">
    <div class="promise__bg" aria-hidden="true"></div>
    <div class="container reveal">
      <p class="overline">You show up. We handle the rest.</p>
      <h2 class="promise__title">إنت تحضر.<br /><span class="accent">احنا نتكفّلو بالباقي.</span></h2>
      <BookCta class="btn btn--solid btn--lg" label={CTA.primary} />
    </div>
  </section>

  <!-- ═══════════════ FAQ — quiet ═══════════════ -->
  <section class="zone zone--quiet zone--edge" id="faq">
    <span class="zindex"><b>09</b> — FAQ</span>
    <div class="container narrow reveal">
      <p class="overline">Questions</p>
      <h2 class="faq-title">أسئلة</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary>{f.q}<i>+</i></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Modal />
  <Footer />
</Base>
<style>
  /* ═══════════ shared ═══════════ */
  .narrow { max-width: 760px; }
  .lead { color: var(--dim); font-size: clamp(16px,2vw,19px); line-height: 1.7; margin-top: 22px; max-width: 62ch; }
  .lead.center { margin-inline: auto; text-align: center; }

  /* ═══════════ HERO ═══════════ */
  .hero { position: relative; overflow: hidden; padding-block: clamp(48px,7vw,90px) clamp(56px,8vw,110px); }
  .hero__bg { position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(50% 45% at 82% 4%, rgba(var(--red-rgb),.20), transparent 62%),
      radial-gradient(40% 40% at 8% 40%, rgba(176,12,18,.10), transparent 60%); }
  /* bloom bleeds into the section below */
  .hero::after { content: ''; position: absolute; left: 0; right: 0; bottom: -120px; height: 220px; z-index: 0; pointer-events: none;
    background: radial-gradient(50% 100% at 72% 0, rgba(var(--red-rgb),.10), transparent 70%); }
  .hero__ghost { position: absolute; z-index: 0; top: 50%; inset-inline-start: 50%; transform: translate(-50%,-50%);
    font-family: var(--font-display); font-weight: 800; font-size: clamp(120px,20vw,300px); letter-spacing: -.03em;
    color: rgba(255,255,255,.02); white-space: nowrap; pointer-events: none; }

  .hero__grid { position: relative; z-index: 1; max-width: var(--maxw); margin-inline: auto; padding-inline: var(--gutter);
    display: grid; grid-template-columns: 0.92fr 1.35fr; gap: clamp(28px,4vw,56px); align-items: center; }
  .hero__meta { display: flex; flex-direction: column; align-items: flex-start; }
  .hero__title { font-family: var(--font-ar); font-weight: 900; line-height: 1.04;
    font-size: clamp(40px,5.6vw,84px); margin-top: 22px; text-wrap: balance; }
  .hero__en { font-family: var(--font-display); font-weight: 700; color: var(--dim);
    font-size: clamp(15px,1.7vw,21px); margin-top: 14px; letter-spacing: -.01em; }
  .hero__promise { font-family: var(--font-ar); font-weight: 900; font-size: clamp(20px,2.6vw,30px); margin-top: 26px; }
  .hero__cta { display: flex; gap: 12px; margin-top: 30px; flex-wrap: wrap; }
  .hero__cta .playdot { width: 8px; height: 8px; border-radius: 50%; background: var(--red); box-shadow: 0 0 10px var(--red); display: inline-block; }
  .hero__trust { color: var(--dim-2); font-size: 13.5px; margin-top: 28px; }

  .hero__film { position: relative; }
  .hero__stage { position: relative; aspect-ratio: 16/10; border-radius: var(--radius-lg); overflow: hidden;
    border: 1px solid var(--line-2); cursor: pointer; background: var(--fill-dark);
    box-shadow: 0 70px 130px -60px rgba(var(--red-rgb),.55);
    transform: translateY(var(--py,0)); transition: transform .5s var(--ease), box-shadow .5s var(--ease); }
  .hero__stage:hover { box-shadow: 0 80px 150px -55px rgba(var(--red-rgb),.7); }
  .hero__stage video { position: absolute; inset: -4%; width: 108%; height: 108%; object-fit: cover; }
  .hero__vignette { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to bottom, rgba(5,5,5,.4), transparent 24%, transparent 66%, rgba(5,5,5,.78)),
                radial-gradient(120% 100% at 50% 50%, transparent 52%, rgba(5,5,5,.5)); }
  .hero__filmmeta { position: absolute; inset-inline: 20px; top: 16px; z-index: 2; display: flex; justify-content: space-between; }
  .hero__filmmeta .meta-label { color: rgba(250,250,250,.72); }
  .hero__play { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); z-index: 2;
    width: 74px; height: 74px; border-radius: 50%; background: var(--red); display: grid; place-items: center;
    box-shadow: 0 0 44px -8px rgba(var(--red-rgb),.9); transition: transform .3s var(--ease); }
  .hero__stage:hover .hero__play { transform: translate(-50%,-50%) scale(1.08); }
  .hero__play span { width: 0; height: 0; border-style: solid; border-width: 12px 0 12px 20px;
    border-color: transparent transparent transparent #fff; margin-left: 5px; direction: ltr; }
  .hero__caption { position: relative; z-index: 1; text-align: center; color: var(--dim); font-size: 14.5px; margin-top: 30px; }
  .hero__caption .dim { color: var(--dim-2); }

  /* ═══════════ REFRAME ═══════════ */
  .reframe-wrap { max-width: 760px; }
  .reframe-title { font-family: var(--font-ar); font-weight: 900; font-size: clamp(30px,4.4vw,58px);
    line-height: 1.14; margin-top: 16px; text-wrap: balance; }
  .reframe-body { margin-bottom: 12px; }
  .reframe { margin-top: 30px; }
  .reframe__row { display: grid; grid-template-columns: 40px 190px 1fr; gap: 22px; align-items: baseline;
    padding: 26px 0; border-top: 1px solid var(--line); }
  .reframe__n { font-family: var(--font-display); font-weight: 800; color: var(--red); font-size: 14px; }
  .reframe__row b { font-family: var(--font-display); font-weight: 700; font-size: 19px; }
  .reframe__v { color: var(--dim); }

  /* ═══════════ BEFORE / AFTER ═══════════ */
  .ba-zone { padding-block: clamp(80px,10vw,150px); }
  .ba-head { text-align: center; }
  .ba-title { font-family: var(--font-ar); font-weight: 900; font-size: clamp(30px,5vw,66px); line-height: 1.08; margin-top: 14px; }
  .ba-stage { margin-block: clamp(40px,6vw,64px); padding-inline: clamp(0px,4vw,60px); }
  .ba { position: relative; max-width: 1320px; margin-inline: auto; aspect-ratio: 21/9; overflow: hidden;
    cursor: ew-resize; user-select: none; border-radius: var(--radius); border: 1px solid var(--line-2);
    box-shadow: 0 60px 120px -50px rgba(var(--red-rgb),.5); }
  .ba__layer { position: absolute; inset: 0; }
  .ba__layer img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ba__before { clip-path: inset(0 0 0 50%); }
  .ba__before img { filter: contrast(.95); }
  .ba__tag { position: absolute; top: 18px; font-family: var(--font-display); font-weight: 700; font-size: 12px;
    letter-spacing: .06em; padding: 7px 15px; border-radius: 999px; background: rgba(0,0,0,.5); backdrop-filter: blur(6px); }
  .ba__tag--b { inset-inline-start: 18px; color: var(--dim); }
  .ba__tag--a { inset-inline-end: 18px; color: #fff; background: var(--red); }
  .ba__handle { position: absolute; inset-block: 0; left: 50%; width: 2px; background: var(--white); transform: translateX(-50%); z-index: 3;
    box-shadow: 0 0 20px rgba(var(--red-rgb),.7); }
  .ba__grip { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    width: 52px; height: 52px; border-radius: 50%; background: var(--red); color: #fff; display: grid; place-items: center;
    font-size: 17px; box-shadow: 0 10px 30px -6px rgba(var(--red-rgb),.9); }
  .ba-sub { text-align: center; color: var(--dim); max-width: 620px; margin: 0 auto; }

  /* ═══════════ SYSTEM (pinned) ═══════════ */
  .system-zone { padding-block: 0; }
  .system-pin { }
  .system-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(32px,5vw,72px); align-items: start;
    padding-block: clamp(80px,10vw,140px); }
  .system-head { position: sticky; top: 100px; }
  .system-title { font-family: var(--font-ar); font-weight: 900; font-size: clamp(30px,4.6vw,60px); line-height: 1.08; margin-top: 14px; }
  .system-foot { margin-top: 28px; color: var(--white); font-weight: 600; font-size: clamp(16px,1.9vw,19px); max-width: 42ch;
    border-inline-start: 2px solid var(--red); padding-inline-start: 18px; }
  .system-steps { display: flex; flex-direction: column; }
  .sstep { display: grid; grid-template-columns: 64px 1fr; gap: 22px; align-items: start;
    padding: clamp(24px,3vw,38px) 0; border-top: 1px solid var(--line); opacity: .34; transition: opacity .5s var(--ease); }
  .sstep:first-child { border-top: none; }
  .sstep.on { opacity: 1; }
  .sstep__n { font-family: var(--font-display); font-weight: 800; font-size: clamp(30px,3.4vw,46px);
    color: transparent; -webkit-text-stroke: 1.5px var(--red); }
  .sstep.on .sstep__n { color: var(--red); -webkit-text-stroke: 0; }
  .sstep__body h3 { font-family: var(--font-display); font-weight: 700; font-size: clamp(20px,2.2vw,27px); }
  .sstep__ar { color: var(--dim); font-weight: 400; font-size: .7em; }
  .sstep__body p { color: var(--dim); margin-top: 8px; line-height: 1.6; }

  /* ═══════════ CADENCE ═══════════ */
  .cadence-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px,5vw,64px); align-items: center; }
  .cadence-head { position: relative; }
  .cadence-title { font-family: var(--font-ar); font-weight: 900; font-size: clamp(28px,4vw,52px); line-height: 1.12; margin-top: 14px; }
  .compare { display: grid; gap: 16px; }
  .compare__col { padding: 30px 28px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--fill-card); }
  .compare__col--good { border-color: rgba(var(--red-rgb),.35); background: linear-gradient(180deg, rgba(var(--red-rgb),.06), var(--surface)); }
  .compare__tag { display: inline-block; font-family: var(--font-display); font-weight: 700; font-size: 12px;
    letter-spacing: .08em; text-transform: uppercase; padding: 6px 14px; border-radius: 999px; background: var(--surface-3); color: var(--dim); margin-bottom: 20px; }
  .compare__tag--accent { background: var(--red); color: #fff; }
  .compare__col ul { display: flex; flex-direction: column; gap: 12px; }
  .compare__col li { display: flex; gap: 12px; font-size: 15.5px; color: var(--dim); }
  .compare__col--good li { color: var(--white); }
  .compare__col li i { font-style: normal; font-weight: 800; color: var(--dim-2); }
  .compare__col--good li i { color: var(--red); }

  /* ═══════════ WHO ═══════════ */
  .who-title { font-family: var(--font-ar); font-weight: 900; font-size: clamp(28px,4.4vw,58px); line-height: 1.12; margin-top: 14px; max-width: 20ch; }
  .who { margin-top: 44px; }
  .who__row { display: grid; grid-template-columns: 44px 320px 1fr; gap: 22px; align-items: baseline;
    padding: 24px 0; border-top: 1px solid var(--line); transition: background .3s; }
  .who__row:hover { background: rgba(255,255,255,.015); }
  .who__n { font-family: var(--font-display); font-weight: 800; color: var(--red); font-size: 14px; }
  .who__row b { font-family: var(--font-ar); font-weight: 900; font-size: clamp(19px,2.4vw,26px); }
  .who__why { color: var(--dim); }
  .who__note { margin-top: 40px; color: var(--dim); font-size: clamp(16px,2vw,19px); max-width: 640px;
    border-inline-start: 2px solid var(--red); padding-inline-start: 20px; }

