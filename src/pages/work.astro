---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ReelModal from '../components/ReelModal.astro';
import { workPage, projects, workCategories, CTA } from '../config';
---
<Base
  title="الأعمال — Next Level"
  description="مشاريع Next Level: كيفاش نحولو خبرة الأطباء، المحامين، الـ consultants والـ founders إلى حضور واضح وثابت."
>
  <Nav current="/work" />

  <main id="main-content">
    <section class="section wk-hero">
      <div class="container">
        <p class="meta"><span class="accent">●</span> Selected Work</p>
        <h1 class="h-hero">{workPage.title}</h1>
        <p class="lead">{workPage.sub}</p>
      </div>
    </section>

    <section class="section--sm">
      <div class="container">
        <div class="wk-filters" id="workFilters" role="group" aria-label="فلترة حسب المجال">
          {workCategories.map((c, i) => (
            <button
              type="button"
              class={`wk-filter ${i === 0 ? 'active' : ''}`}
              data-filter={c.key}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >{c.label}</button>
          ))}
        </div>

        <div class="wk-grid">
          {projects.map((p, i) => (
            <a
              href={`/work/${p.slug}`}
              class={`wk-card ${i % 3 === 0 ? 'wk-card--tall' : ''}`}
              data-project-cat={p.category}
            >
              <span class="wk-card__frame">
                <img src={p.poster} alt="" width="720" height="900" loading={i < 2 ? 'eager' : 'lazy'} />
                {p.placeholder && <span class="wk-badge">عيّنة — بانتظار مشاريع موثقة</span>}
              </span>
              <span class="wk-card__row">
                <span class="wk-card__title">{p.title}</span>
                <span class="wk-card__cat latin">{p.category}</span>
              </span>
              <span class="wk-card__sum">{p.summary}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section--sm wk-cta">
      <div class="container">
        <hr class="rule" />
        <div class="wk-cta__row">
          <p class="h-display">مشروعك الجاي؟</p>
          <a href="/book" class="btn btn--solid btn--lg">{CTA.primary}</a>
        </div>
      </div>
    </section>
  </main>

  <ReelModal />
  <Footer />
</Base>

<style>
  .wk-hero { padding-top: clamp(140px, 20vh, 220px); padding-bottom: var(--space-5); }
  .wk-hero h1 { margin-top: 16px; }
  .wk-hero .lead { margin-top: 18px; }

  .wk-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: var(--space-5); }
  .wk-filter {
    min-height: 44px; padding: 10px 20px;
    border: 1px solid var(--white-16); border-radius: var(--radius-small);
    font-weight: 600; font-size: var(--text-sm); color: var(--white-70);
    cursor: pointer; transition: 0.2s var(--ease);
  }
  .wk-filter:hover { color: var(--color-white); border-color: var(--white-40); }
  .wk-filter.active { background: var(--color-red); border-color: var(--color-red); color: var(--color-white); }

  .wk-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2.5vw, 28px);
  }
  .wk-card { display: flex; flex-direction: column; gap: 10px; }
  .wk-card__frame {
    position: relative; display: block; overflow: hidden;
    aspect-ratio: 4 / 5; border-radius: var(--radius-medium);
    border: 1px solid var(--white-08); background: #141010;
  }
  .wk-card--tall .wk-card__frame { aspect-ratio: 3 / 4; }
  .wk-card__frame img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease); }
  .wk-card:hover .wk-card__frame img { transform: scale(1.04); }
  .wk-badge {
    position: absolute; bottom: 10px; inset-inline-start: 10px; inset-inline-end: 10px;
    padding: 6px 10px; font-size: 11px; font-weight: 600; text-align: center;
    background: var(--black-72); color: var(--white-70);
    border: 1px solid var(--white-16); border-radius: var(--radius-small);
    backdrop-filter: blur(6px);
  }
  .wk-card__row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .wk-card__title { font-weight: 700; font-size: var(--text-lg); }
  .wk-card__cat { font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-red); }
  .wk-card__sum { color: var(--white-70); font-size: var(--text-sm); line-height: 1.7; }

  .wk-cta__row {
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding-top: var(--space-5); flex-wrap: wrap;
  }

  @media (max-width: 1000px) { .wk-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .wk-grid { grid-template-columns: 1fr; } }
</style>
