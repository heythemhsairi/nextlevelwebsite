---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ReelModal from '../components/ReelModal.astro';
import { workPage, workItems, workCollections, CTA } from '../config';
---
<Base
  title="الأعمال — Next Level"
  description="أعمال Next Level الحقيقية: سلسلة المحتوى التعليمي لسلمى الشارني وcreatives إعلانية لـ Focus Plus — من الكتابة للنشر."
>
  <Nav current="/work" />

  <main id="main-content">
    <section class="section wk-hero">
      <div class="container">
        <p class="meta"><span class="accent">●</span> Selected Work</p>
        <h1 class="h-hero">{workPage.title}</h1>
        <p class="lead">{workPage.sub}</p>
      </div>
    </section>

    {workCollections.map((col, ci) => {
      const items = workItems.filter((w) => w.collection === col.key);
      return (
        <section class="section--sm wk-col" id={col.key}>
          <div class="container">
            <div class="sindex"><b>0{ci + 1}</b> {col.client}</div>
            <header class="wk-col__head">
              <h2 class="h-display latin">{col.client}</h2>
              <div class="wk-col__meta">
                <span class="wk-col__cat latin">{col.category}</span>
                <p class="wk-col__intro">{col.intro}</p>
              </div>
            </header>

            <div class="wk-grid" data-count={items.length}>
              {items.map((w, i) => (
                <article class="wk-card" data-hover-preview>
                  <button
                    type="button"
                    class="wk-card__frame"
                    data-reel={w.fullVideo}
                    data-reel-poster={w.poster}
                    data-reel-ar={w.aspectRatio}
                    aria-label={`شغّل: ${w.title}`}
                  >
                    <img
                      src={w.poster}
                      alt={`Poster — ${w.title} (${w.client})`}
                      width="720" height="1280"
                      loading={ci === 0 && i < 2 ? 'eager' : 'lazy'}
                    />
                    <video
                      class="wk-card__preview"
                      src={w.previewVideo}
                      muted loop playsinline preload="none"
                      aria-hidden="true"
                      tabindex="-1"
                    ></video>
                    <span class="wk-card__playbtn" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    </span>
                  </button>
                  <div class="wk-card__body">
                    <a href={`/work/${w.slug}`} class="wk-card__title latin" dir="ltr">{w.title}</a>
                    <p class="wk-card__sum">{w.summary}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      );
    })}

    <section class="section--sm wk-cta">
      <div class="container">
        <hr class="rule" />
        <div class="wk-cta__row">
          <p class="h-display">مشروعك الجاي؟</p>
          <a href="/book" class="btn btn--solid btn--lg">{CTA.primary}</a>
        </div>
      </div>
    </section>
  </main>

  <ReelModal />
  <Footer />
</Base>

<style>
  .wk-hero { padding-top: clamp(140px, 20vh, 220px); padding-bottom: var(--space-4); }
  .wk-hero h1 { margin-top: 16px; }
  .wk-hero .lead { margin-top: 18px; }

  .wk-col + .wk-col { border-top: 1px solid var(--white-08); }

  .wk-col__head {
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);
    align-items: end; margin-bottom: var(--space-5);
  }
  .wk-col__cat {
    font-size: 11px; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--color-red);
  }
  .wk-col__intro { margin-top: 8px; color: var(--white-70); font-size: var(--text-sm); line-height: 1.75; max-width: 44ch; }

  .wk-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(14px, 2vw, 24px); }
  .wk-grid[data-count="3"] { grid-template-columns: repeat(3, 1fr); max-width: 980px; }

  .wk-card { display: flex; flex-direction: column; gap: 12px; }
  .wk-card__frame {
    position: relative; display: block; width: 100%; overflow: hidden;
    aspect-ratio: 9 / 16; border-radius: var(--radius-medium);
    border: 1px solid var(--white-08); background: #141010;
    padding: 0; cursor: pointer;
  }
  .wk-card__frame img,
  .wk-card__preview {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  .wk-card__preview { opacity: 0; transition: opacity 0.3s var(--ease); }
  .wk-card.previewing .wk-card__preview { opacity: 1; }
  .wk-card__playbtn {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--color-red); color: var(--color-white);
    display: grid; place-items: center;
    transition: transform 0.25s var(--ease), opacity 0.25s;
  }
  .wk-card:hover .wk-card__playbtn { transform: translate(-50%, -50%) scale(1.08); }
  .wk-card__frame:focus-visible { box-shadow: var(--focus-ring); }

  .wk-card__body { display: flex; flex-direction: column; gap: 6px; padding-inline: 2px; }
  .wk-card__title {
    font-weight: 700; font-size: var(--text-sm); color: var(--color-white);
    min-height: 44px; display: inline-flex; align-items: center;
  }
  .wk-card__title:hover { color: var(--color-red); }
  .wk-card__sum { color: var(--white-70); font-size: var(--text-xs); line-height: 1.7; }

  .wk-cta__row {
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding-top: var(--space-5); flex-wrap: wrap;
  }

  @media (max-width: 1000px) {
    .wk-grid, .wk-grid[data-count="3"] { grid-template-columns: repeat(2, 1fr); }
    .wk-col__head { grid-template-columns: 1fr; align-items: start; }
  }
  @media (max-width: 560px) {
    .wk-grid, .wk-grid[data-count="3"] { grid-template-columns: 1fr 1fr; gap: 10px; }
    .wk-card__playbtn { width: 44px; height: 44px; }
  }
</style>
