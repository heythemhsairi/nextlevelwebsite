---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, bookPage, whatsappLink, hasRealWhatsapp, CTA } from '../config';

const fallbackMailto =
  `mailto:${site.email}?subject=${encodeURIComponent('Next Level — Call Request')}`;
---
<Base
  title="احجز مكالمة — Next Level"
  description="مكالمة 15 دقيقة: نفهمو مجالك وحضورك الحالي، ونحددو الـ system المناسبة ليك. بلا تعقيد وبلا ضغط."
>
  <Nav current="/book" />

  <main id="main-content">
    <section class="section bk">
      <div class="container bk__grid">
        <header class="bk__intro">
          <p class="meta"><span class="accent">●</span> Book a Call</p>
          <h1 class="h-hero">{bookPage.title}</h1>
          <p class="lead">{bookPage.sub}</p>

          {hasRealWhatsapp && (
            <div class="bk__direct">
              <p class="meta">ولا مباشرة:</p>
              <a href={whatsappLink('السلام عليكم Next Level 👋 نحب نحجز مكالمة.')} target="_blank" rel="noopener" class="bk__wa latin" dir="ltr">
                {site.whatsappDisplay}
              </a>
            </div>
          )}
        </header>

        <div class="bk__panel glass">
          <form class="bk-form" id="bookForm" novalidate>
            {bookPage.fields.map((f) => (
              <label>
                {f.label}
                <input type={f.type} name={f.name} placeholder={f.placeholder} required={f.required} autocomplete={f.name === 'name' ? 'name' : 'tel'} />
              </label>
            ))}

            <label>{bookPage.areaLabel}
              <select name="area" required>
                <option value="" disabled selected>اختار</option>
                {bookPage.areas.map((a) => <option>{a}</option>)}
              </select>
            </label>

            <label>{bookPage.situationLabel}
              <select name="situation" required>
                <option value="" disabled selected>اختار</option>
                {bookPage.situations.map((s) => <option>{s}</option>)}
              </select>
            </label>

            <label>{bookPage.serviceLabel}
              <select name="service" required>
                <option value="" disabled selected>اختار</option>
                {bookPage.serviceOptions.map((s) => <option>{s}</option>)}
              </select>
            </label>

            <label>{bookPage.objectiveLabel}
              <select name="objective" required>
                <option value="" disabled selected>اختار</option>
                {bookPage.objectives.map((o) => <option>{o}</option>)}
              </select>
            </label>

            <button type="submit" class="btn btn--solid btn--lg bk-form__submit">{CTA.primary}</button>
            <p class="bk-form__ok" id="bookOk" role="status"></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline define:vars={{ wa: site.whatsapp, mailto: fallbackMailto, useWhatsapp: hasRealWhatsapp ? '1' : '' }}>
    document.getElementById('bookForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = e.target;
      let ok = true, first = null;
      f.querySelectorAll('[required]').forEach((i) => {
        const bad = !String(i.value).trim();
        i.classList.toggle('invalid', bad);
        if (bad) { ok = false; first = first || i; }
      });
      if (!ok) { first && first.focus(); return; }

      const body =
`السلام عليكم Next Level 👋
• الاسم: ${f.name.value.trim()}
• المجال: ${f.area.value}
• الوضع الحالي: ${f.situation.value}
• الصيغة: ${f.service.value}
• الهدف: ${f.objective.value}
• WhatsApp: ${f.phone.value.trim()}

نحب نحجز مكالمة 15 دقيقة.`;

      const el = document.getElementById('bookOk');
      if (useWhatsapp) {
        const url = `https://wa.me/${wa}?text=${encodeURIComponent(body)}`;
        const win = window.open(url, '_blank');
        if (win) el.textContent = 'تمّت! كمّل الإرسال على WhatsApp ونرجعولك بسرعة. ✓';
        else el.innerHTML = 'اضغط باش تكمّل ← <a href="' + url + '" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline">افتح WhatsApp</a>';
      } else {
        window.location.href = `${mailto}&body=${encodeURIComponent(body)}`;
        el.textContent = 'تمّت! يتفتح الـ email باش تبعث الطلب. ✓';
      }
      el.classList.add('show');
    });
  </script>
</Base>

<style>
  .bk { padding-top: clamp(130px, 18vh, 200px); }
  .bk__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .bk__intro h1 { margin-top: 16px; }
  .bk__intro .lead { margin-top: 18px; }
  .bk__direct { margin-top: var(--space-5); border-top: 1px solid var(--white-08); padding-top: var(--space-4); }
  .bk__wa {
    display: inline-flex; align-items: center; min-height: 44px;
    margin-top: 8px; font-weight: 700; font-size: var(--text-xl); color: var(--color-white);
  }
  .bk__wa:hover { color: var(--color-red); }

  .bk__panel { border-radius: var(--radius-large); padding: clamp(22px, 4vw, 36px); }
  .bk-form { display: flex; flex-direction: column; gap: 18px; }
  .bk-form label { display: flex; flex-direction: column; gap: 8px; font-weight: 600; font-size: var(--text-sm); }
  .bk-form input, .bk-form select {
    background: rgba(10, 8, 8, 0.5); border: 1px solid var(--white-16);
    border-radius: var(--radius-small); padding: 14px 16px; min-height: 52px;
    color: var(--color-white); font-family: inherit; font-size: var(--text-sm);
    transition: border-color 0.2s;
    /* selects size to their longest option intrinsically — cap them to the
       column or they force the whole page wider on small screens */
    width: 100%; min-width: 0;
  }
  .bk-form input:focus, .bk-form select:focus { outline: none; border-color: var(--color-red); }
  .bk-form input::placeholder { color: var(--white-55); }
  .bk-form .invalid { border-color: var(--color-red); }
  .bk-form__submit { margin-top: 6px; width: 100%; }
  .bk-form__ok {
    display: none; text-align: center; font-weight: 600; font-size: var(--text-sm);
    border: 1px solid var(--red-40); background: var(--red-12);
    border-radius: var(--radius-small); padding: 14px;
  }
  .bk-form__ok.show { display: block; }

  @media (max-width: 860px) {
    .bk__grid { grid-template-columns: 1fr; }
  }
</style>
