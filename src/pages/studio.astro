---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { studioPage, founders, CTA } from '../config';
---
<Base
  title="الـ Studio — Next Level"
  description="قصة Next Level، المؤسسين Walif Doukh وHeythem Hsairi، ومبادئ الخدمة اللي يخدم بيها الـ studio."
>
  <Nav current="/studio" />

  <main id="main-content">
    <section class="section st-hero">
      <div class="container">
        <p class="meta"><span class="accent">●</span> The Studio</p>
        <h1 class="h-hero">{studioPage.title}</h1>
      </div>
    </section>

    <!-- story -->
    <section class="section--sm">
      <div class="container st-story">
        <h2 class="meta">القصة</h2>
        <div class="st-story__body">
          {studioPage.story.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- founders -->
    <section class="on-light section st-founders">
      <div class="container">
        <div class="sindex"><b>·</b> Founders</div>
        <div class="st-founders__grid">
          {founders.map((f) => (
            <div class="st-founder">
              {f.photo ? (
                <img src={f.photo} alt={`صورة ${f.name}`} width="600" height="750" loading="lazy" />
              ) : (
                <div class="st-founder__pending" role="img" aria-label={`صورة ${f.name} — قريبًا`}>
                  <span class="latin">Portrait coming</span>
                </div>
              )}
              <h3 class="latin">{f.name}</h3>
              <p class="latin">{f.role}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- principles -->
    <section class="section">
      <div class="container">
        <div class="sindex"><b>·</b> كيفاش نخدمو</div>
        <div class="st-prin">
          {studioPage.principles.map((p, i) => (
            <div class="st-prin__item">
              <span class="latin">0{i + 1}</span>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- capabilities (real team names not yet published → labelled Capabilities) -->
    <section class="section--sm st-caps">
      <div class="container">
        <h2 class="meta">{studioPage.capabilities.title}</h2>
        <p class="st-caps__note">{studioPage.capabilities.note}</p>
        <ul class="st-caps__list">
          {studioPage.capabilities.list.map((c) => (
            <li>
              <b class="latin">{c.name}</b>
              <span>{c.role}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="section--sm st-cta">
      <div class="container">
        <hr class="rule" />
        <div class="st-cta__row">
          <p class="h-display">تحب الـ studio هاذي تخدم معاك؟</p>
          <div class="st-cta__btns">
            <a href="/services" class="btn btn--line">شوف الخدمات</a>
            <a href="/book" class="btn btn--solid btn--lg">{CTA.primary}</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .st-hero { padding-top: clamp(140px, 20vh, 220px); padding-bottom: var(--space-4); }
  .st-hero h1 { margin-top: 16px; max-width: 18ch; }

  .st-story { display: grid; grid-template-columns: 200px 1fr; gap: var(--space-5); align-items: start; }
  .st-story__body { max-width: 62ch; display: flex; flex-direction: column; gap: 18px; }
  .st-story__body p { font-size: var(--text-lg); line-height: 1.85; color: var(--white-70); }
  .st-story__body p:first-child { color: var(--color-white); }

  .st-founders__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 4vw, 48px); max-width: 880px; }
  .st-founder img, .st-founder__pending { aspect-ratio: 4 / 5; width: 100%; object-fit: cover; border-radius: var(--radius-medium); }
  .st-founder__pending {
    display: grid; place-items: center;
    background: var(--black-08); border: 1px dashed var(--black-16);
    color: var(--black-64); font-size: var(--text-xs);
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  .st-founder h3 { margin-top: 16px; font-weight: 700; font-size: var(--text-xl); }
  .st-founder p { color: var(--color-red); font-weight: 600; font-size: var(--text-sm); margin-top: 2px; }

  .st-prin { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .st-prin__item { border-top: 1px solid var(--white-10); padding-top: 16px; }
  .st-prin__item span { font-size: var(--text-xs); font-weight: 600; color: var(--color-red); letter-spacing: 0.14em; }
  .st-prin__item h3 { margin-top: 10px; font-size: var(--text-lg); font-weight: 700; }
  .st-prin__item p { margin-top: 8px; color: var(--white-70); font-size: var(--text-sm); line-height: 1.75; }

  .st-caps__note { margin-top: 10px; color: var(--white-55); font-size: var(--text-sm); }
  .st-caps__list { margin-top: 18px; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0 32px; }
  .st-caps__list li {
    display: flex; flex-direction: column; gap: 2px;
    padding-block: 14px; border-bottom: 1px solid var(--white-08);
  }
  .st-caps__list b { font-weight: 600; font-size: var(--text-sm); }
  .st-caps__list span { color: var(--white-55); font-size: var(--text-xs); }

  .st-cta__row { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-top: var(--space-5); flex-wrap: wrap; }
  .st-cta__btns { display: flex; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .st-story { grid-template-columns: 1fr; gap: 16px; }
    .st-prin { grid-template-columns: 1fr 1fr; }
    .st-caps__list { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .st-prin, .st-caps__list { grid-template-columns: 1fr; }
    .st-founders__grid { grid-template-columns: 1fr 1fr; gap: 14px; }
  }
</style>
