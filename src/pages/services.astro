---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { servicesPage, services, CTA, whatsappLink } from '../config';
---
<Base
  title="الخدمات — Next Level"
  description="زوز صيغ إنتاج: Full-Stack Production وRemote Content System. من الفكرة للنشر، system شهرية تحت مسؤولية team واحدة."
>
  <Nav current="/services" />

  <main id="main-content">
    <section class="section sv-hero">
      <div class="container">
        <p class="meta"><span class="accent">●</span> Services</p>
        <h1 class="h-hero">{servicesPage.title}</h1>
        <p class="lead">{servicesPage.sub}</p>
      </div>
    </section>

    <!-- the two services, full detail -->
    <section class="section--sm">
      <div class="container sv-list">
        {services.map((s, i) => (
          <article class="sv-item" id={s.slug}>
            <header class="sv-item__head">
              <span class="sv-item__idx latin">{s.index}</span>
              <div>
                <h2 class="sv-item__name latin">{s.name}</h2>
                <p class="sv-item__ar">{s.nameAr}</p>
              </div>
            </header>
            <div class="sv-item__grid">
              <div>
                <p class="sv-item__copy">{s.copy}</p>
                <p class="sv-item__process latin" dir="ltr">{s.process.join(' → ')}</p>
                <p class="sv-item__who">{s.forWho}</p>
                <a href="/book" class={`btn ${i === 0 ? 'btn--solid' : 'btn--line'}`}>{CTA.primary}</a>
              </div>
              <div>
                <h3 class="meta">شنوّة يشمل</h3>
                <ul class="sv-item__inc">
                  {s.includes.map((inc) => <li>{inc}</li>)}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- comparison -->
    <section class="on-light section sv-cmp">
      <div class="container">
        <div class="sindex"><b>·</b> الفرق باختصار</div>
        <h2 class="h-display">شنوّة يتبدّل بين الصيغتين؟</h2>
        <div class="sv-cmp__table" role="table" aria-label="مقارنة الخدمتين">
          <div class="sv-cmp__row sv-cmp__row--head" role="row">
            <span role="columnheader">المرحلة</span>
            <span role="columnheader" class="latin">Full-Stack</span>
            <span role="columnheader" class="latin">Remote</span>
          </div>
          {[
            ['الخطة والاستراتيجية', 'علينا', 'علينا'],
            ['كتابة الـ Scripts', 'علينا', 'علينا'],
            ['التصوير', 'علينا — جلسة منظمة', 'عليك — بتوجيهنا وshot lists'],
            ['رفع الملفات', '—', 'نظام رفع بسيط'],
            ['المونتاج والصوت', 'علينا', 'علينا'],
            ['الموافقة', 'إنت توافق', 'إنت توافق'],
            ['النشر والجدولة', 'علينا', 'علينا'],
          ].map(([stage, a, b]) => (
            <div class="sv-cmp__row" role="row">
              <span role="cell">{stage}</span>
              <span role="cell">{a}</span>
              <span role="cell">{b}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- monthly workflow -->
    <section class="section">
      <div class="container">
        <div class="sindex"><b>·</b> {servicesPage.monthly.title}</div>
        <ol class="sv-flow">
          {servicesPage.monthly.steps.map((st) => (
            <li class="sv-flow__step">
              <span class="sv-flow__n latin">{st.n}</span>
              <h3>{st.t}</h3>
              <p>{st.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- onboarding + responsibilities -->
    <section class="section--sm sv-two">
      <div class="container sv-two__grid">
        <div>
          <h2 class="meta">{servicesPage.onboarding.title}</h2>
          <ol class="sv-onb">
            {servicesPage.onboarding.steps.map((s, i) => (
              <li><span class="latin">0{i + 1}</span>{s}</li>
            ))}
          </ol>
        </div>
        <div>
          <h2 class="meta">{servicesPage.responsibilities.title}</h2>
          <div class="sv-resp">
            <div>
              <h3>علينا</h3>
              <ul>{servicesPage.responsibilities.ours.map((r) => <li>{r}</li>)}</ul>
            </div>
            <div>
              <h3>عليك</h3>
              <ul>{servicesPage.responsibilities.yours.map((r) => <li>{r}</li>)}</ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section--sm" id="faq">
      <div class="container sv-faq">
        <h2 class="h-display">أسئلة متكررة</h2>
        <div class="sv-faq__list">
          {servicesPage.faqs.map((f) => (
            <details class="sv-faq__item">
              <summary>{f.q}<i aria-hidden="true">+</i></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="on-red section--sm sv-cta">
      <div class="container sv-cta__row">
        <h2 class="h-display">نبداو بمكالمة 15 دقيقة.</h2>
        <div class="sv-cta__btns">
          <a href="/book" class="btn sv-cta__book">{CTA.primary}</a>
          <a href={whatsappLink('السلام عليكم Next Level 👋 عندي سؤال على الخدمات.')} target="_blank" rel="noopener" class="btn sv-cta__wa">{CTA.whatsapp}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .sv-hero { padding-top: clamp(140px, 20vh, 220px); padding-bottom: var(--space-4); }
  .sv-hero h1 { margin-top: 16px; }
  .sv-hero .lead { margin-top: 18px; }

  .sv-list { display: flex; flex-direction: column; gap: var(--space-6); }
  .sv-item { border-top: 1px solid var(--white-10); padding-top: var(--space-5); }
  .sv-item__head { display: flex; align-items: baseline; gap: 20px; }
  .sv-item__idx { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.2em; color: var(--color-red); }
  .sv-item__name { font-weight: 700; font-size: var(--text-2xl); letter-spacing: -0.01em; }
  .sv-item__ar { color: var(--white-55); margin-top: 2px; }
  .sv-item__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--space-5); margin-top: var(--space-4); }
  .sv-item__copy { font-size: var(--text-lg); line-height: 1.8; color: var(--white-70); max-width: 54ch; }
  .sv-item__process { margin-top: 18px; font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.06em; color: var(--color-red); }
  .sv-item__who { margin-top: 10px; color: var(--white-55); font-size: var(--text-sm); }
  .sv-item .btn { margin-top: 24px; }
  .sv-item__inc { margin-top: 12px; columns: 2; column-gap: 28px; }
  .sv-item__inc li {
    break-inside: avoid; padding-block: 10px; border-bottom: 1px solid var(--white-08);
    font-size: var(--text-sm); font-weight: 500;
  }

  .sv-cmp h2 { margin-top: 4px; }
  .sv-cmp__table { margin-top: var(--space-5); border: 1px solid var(--black-16); border-radius: var(--radius-medium); overflow: hidden; }
  .sv-cmp__row { display: grid; grid-template-columns: 1.2fr 1fr 1fr; }
  .sv-cmp__row > span { padding: 14px 18px; font-size: var(--text-sm); border-bottom: 1px solid var(--black-08); }
  .sv-cmp__row:last-child > span { border-bottom: none; }
  .sv-cmp__row--head > span { background: var(--color-black); color: var(--color-white); font-weight: 600; }
  .sv-cmp__row > span:first-child { font-weight: 600; }

  .sv-flow { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px 28px; counter-reset: flow; }
  .sv-flow__step { border-top: 1px solid var(--white-10); padding-top: 16px; }
  .sv-flow__n { font-size: var(--text-xs); font-weight: 600; color: var(--color-red); letter-spacing: 0.14em; }
  .sv-flow__step h3 { margin-top: 8px; font-size: var(--text-lg); font-weight: 700; }
  .sv-flow__step p { margin-top: 6px; color: var(--white-70); font-size: var(--text-sm); line-height: 1.75; }

  .sv-two__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); }
  .sv-onb { margin-top: 14px; display: flex; flex-direction: column; }
  .sv-onb li { display: flex; gap: 14px; align-items: baseline; padding-block: 12px; border-bottom: 1px solid var(--white-08); }
  .sv-onb span { color: var(--color-red); font-weight: 600; font-size: var(--text-xs); }
  .sv-resp { margin-top: 14px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .sv-resp h3 { font-size: var(--text-sm); font-weight: 700; color: var(--color-red); margin-bottom: 6px; }
  .sv-resp li { padding-block: 9px; border-bottom: 1px solid var(--white-08); font-size: var(--text-sm); }

  .sv-faq__list { margin-top: var(--space-4); display: flex; flex-direction: column; gap: 10px; max-width: 780px; }
  .sv-faq__item { border: 1px solid var(--white-08); border-radius: var(--radius-small); overflow: hidden; }
  .sv-faq__item[open] { border-color: var(--white-16); }
  .sv-faq__item summary {
    list-style: none; cursor: pointer; padding: 18px 20px; min-height: 44px;
    font-weight: 600; display: flex; justify-content: space-between; align-items: center; gap: 14px;
  }
  .sv-faq__item summary::-webkit-details-marker { display: none; }
  .sv-faq__item summary i { font-style: normal; color: var(--color-red); font-size: 22px; transition: transform 0.25s var(--ease); }
  .sv-faq__item[open] summary i { transform: rotate(45deg); }
  .sv-faq__item p { padding: 0 20px 18px; color: var(--white-70); line-height: 1.8; font-size: var(--text-sm); }

  .sv-cta__row { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .sv-cta__btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .sv-cta__book { background: var(--color-black); color: var(--color-white); }
  .sv-cta__book:hover { background: #1d1717; }
  .sv-cta__wa { border: 1px solid rgba(10, 8, 8, 0.4); color: var(--color-white); }
  .sv-cta__wa:hover { border-color: var(--color-black); }

  @media (max-width: 900px) {
    .sv-item__grid, .sv-two__grid { grid-template-columns: 1fr; gap: var(--space-4); }
    .sv-flow { grid-template-columns: 1fr 1fr; }
    .sv-item__inc { columns: 1; }
  }
  @media (max-width: 620px) {
    .sv-flow { grid-template-columns: 1fr; }
    .sv-cmp__row { grid-template-columns: 1fr; }
    .sv-cmp__row > span { border-bottom: none; padding-block: 6px; }
    .sv-cmp__row > span:first-child { padding-top: 14px; font-weight: 700; }
    .sv-cmp__row > span:last-child { border-bottom: 1px solid var(--black-08); padding-bottom: 14px; }
    .sv-cmp__row--head { display: none; }
    .sv-cmp__row > span[role="cell"]:nth-child(2)::before { content: 'Full-Stack — '; font-weight: 600; }
    .sv-cmp__row > span[role="cell"]:nth-child(3)::before { content: 'Remote — '; font-weight: 600; }
    .sv-resp { grid-template-columns: 1fr; }
  }
</style>
