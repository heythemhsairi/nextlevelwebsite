---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ReelModal from '../../components/ReelModal.astro';
import { projects, CTA } from '../../config';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props;
const others = projects.filter((p) => p.slug !== project.slug).slice(0, 3);
---
<Base
  title={`${project.title} — أعمال Next Level`}
  description={project.summary}
>
  <Nav current="/work" />

  <main id="main-content">
    <article>
      <section class="pj-hero section--sm">
        <div class="container">
          <a href="/work" class="pj-back meta">→ كل الأعمال</a>
          <div class="pj-hero__row">
            <h1 class="h-hero">{project.title}</h1>
            <span class="pj-cat latin">{project.category}</span>
          </div>
          {project.placeholder && (
            <p class="pj-note">
              هذه الصفحة <b>عيّنة صيغة</b> بوسائط مؤقتة — تتعوض بمشروع موثق (اسم، تحدي، نتيجة، شهادة) قبل الإطلاق.
            </p>
          )}
        </div>
      </section>

      <section class="pj-media">
        <div class="container">
          <figure class="pj-frame">
            {project.video ? (
              <button
                type="button"
                class="pj-play"
                data-reel={project.video}
                data-reel-poster={project.poster}
                aria-label={`شغّل فيديو ${project.title}`}
              >
                <img src={project.poster} alt="" width="1280" height="720" />
                <span class="pj-play__btn" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </button>
            ) : (
              <img src={project.poster} alt="" width="1280" height="720" />
            )}
          </figure>
        </div>
      </section>

      <section class="section--sm">
        <div class="container pj-body">
          <div class="pj-col">
            <h2 class="meta">الملخص</h2>
            <p class="pj-text">{project.summary}</p>
            {project.approach && (
              <>
                <h2 class="meta pj-h">المقاربة</h2>
                <p class="pj-text">{project.approach}</p>
              </>
            )}
          </div>
          {project.deliverables && (
            <div class="pj-col">
              <h2 class="meta">التسليمات</h2>
              <ul class="pj-deliv">
                {project.deliverables.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          )}
        </div>
      </section>

      <section class="section--sm pj-more">
        <div class="container">
          <hr class="rule" />
          <h2 class="meta pj-more__t">أعمال أخرى</h2>
          <div class="pj-more__grid">
            {others.map((p) => (
              <a href={`/work/${p.slug}`} class="pj-more__card">
                <img src={p.poster} alt="" width="480" height="600" loading="lazy" />
                <span>{p.title}</span>
              </a>
            ))}
          </div>
          <a href="/book" class="btn btn--solid btn--lg pj-more__cta">{CTA.primary}</a>
        </div>
      </section>
    </article>
  </main>

  <ReelModal />
  <Footer />
</Base>

<style>
  .pj-hero { padding-top: clamp(130px, 18vh, 190px); }
  .pj-back { display: inline-flex; align-items: center; min-height: 44px; color: var(--white-40); }
  .pj-back:hover { color: var(--color-white); }
  .pj-hero__row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 10px; }
  .pj-cat { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-red); }
  .pj-note {
    margin-top: 20px; padding: 14px 18px; max-width: 640px;
    border: 1px dashed var(--red-40); border-radius: var(--radius-small);
    color: var(--white-70); font-size: var(--text-sm);
  }
  .pj-note b { color: var(--color-red); }

  .pj-frame { border-radius: var(--radius-large); overflow: hidden; border: 1px solid var(--white-10); }
  .pj-play { position: relative; display: block; width: 100%; padding: 0; cursor: pointer; }
  .pj-play img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .pj-play__btn {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 72px; height: 72px; border-radius: 50%;
    background: var(--color-red); color: var(--color-white);
    display: grid; place-items: center;
    transition: transform 0.25s var(--ease);
  }
  .pj-play:hover .pj-play__btn { transform: translate(-50%, -50%) scale(1.07); }
  .pj-play:focus-visible .pj-play__btn { box-shadow: var(--focus-ring); }

  .pj-body { display: grid; grid-template-columns: 1.4fr 0.6fr; gap: var(--space-5); }
  .pj-h { margin-top: var(--space-4); }
  .pj-text { margin-top: 10px; line-height: 1.85; color: var(--white-70); max-width: 60ch; }
  .pj-deliv { margin-top: 10px; display: flex; flex-direction: column; }
  .pj-deliv li { padding-block: 12px; border-bottom: 1px solid var(--white-08); font-weight: 500; }

  .pj-more__t { margin-top: var(--space-4); }
  .pj-more__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 16px; }
  .pj-more__card { display: flex; flex-direction: column; gap: 8px; font-weight: 600; font-size: var(--text-sm); }
  .pj-more__card img { aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-medium); border: 1px solid var(--white-08); transition: transform 0.4s var(--ease); }
  .pj-more__card:hover img { transform: translateY(-4px); }
  .pj-more__cta { margin-top: var(--space-5); }

  @media (max-width: 820px) {
    .pj-body { grid-template-columns: 1fr; gap: var(--space-4); }
    .pj-more__grid { grid-template-columns: 1fr; }
  }
</style>
