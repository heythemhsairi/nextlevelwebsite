---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ReelModal from '../../components/ReelModal.astro';
import { workItems, CTA } from '../../config';

export function getStaticPaths() {
  return workItems.map((w) => ({ params: { slug: w.slug }, props: { item: w } }));
}
const { item } = Astro.props;
const others = workItems.filter((w) => w.collection === item.collection && w.slug !== item.slug);
---
<Base
  title={`${item.title} — ${item.client} | Next Level`}
  description={item.summary}
>
  <Nav current="/work" />

  <main id="main-content">
    <article>
      <section class="pj-hero section--sm">
        <div class="container">
          <a href="/work" class="pj-back meta">→ كل الأعمال</a>
          <div class="pj-hero__row">
            <h1 class="h-hero latin" dir="ltr">{item.title}</h1>
            <div class="pj-tags">
              <span class="pj-client latin">{item.client}</span>
              <span class="pj-cat latin">{item.category}</span>
            </div>
          </div>
        </div>
      </section>

      <section class="pj-media">
        <div class="container pj-media__wrap">
          <button
            type="button"
            class="pj-play"
            data-reel={item.fullVideo}
            data-reel-poster={item.poster}
            data-reel-ar={item.aspectRatio}
            aria-label={`شغّل فيديو ${item.title}`}
          >
            <img src={item.poster} alt={`Poster — ${item.title}`} width="720" height="1280" />
            <span class="pj-play__btn" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </button>
          <div class="pj-side">
            <h2 class="meta">الملخص</h2>
            <p class="pj-text">{item.summary}</p>
            <h2 class="meta pj-h">Client</h2>
            <p class="pj-text latin">{item.client}</p>
            <h2 class="meta pj-h">Category</h2>
            <p class="pj-text latin">{item.category}</p>
            <a href="/book" class="btn btn--solid pj-cta">{CTA.primary}</a>
          </div>
        </div>
      </section>

      {others.length > 0 && (
        <section class="section--sm pj-more">
          <div class="container">
            <hr class="rule" />
            <h2 class="meta pj-more__t">من نفس المجموعة</h2>
            <div class="pj-more__grid">
              {others.map((w) => (
                <a href={`/work/${w.slug}`} class="pj-more__card">
                  <img src={w.poster} alt="" width="480" height="854" loading="lazy" />
                  <span class="latin" dir="ltr">{w.title}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}
    </article>
  </main>

  <ReelModal />
  <Footer />
</Base>

<style>
  .pj-hero { padding-top: clamp(130px, 18vh, 190px); }
  .pj-back { display: inline-flex; align-items: center; min-height: 44px; color: var(--white-55); }
  .pj-back:hover { color: var(--color-white); }
  .pj-hero__row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 10px; }
  .pj-hero__row h1 { font-size: var(--text-3xl); }
  .pj-tags { display: flex; gap: 14px; align-items: baseline; }
  .pj-client { font-weight: 700; font-size: var(--text-sm); }
  .pj-cat { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-red); }

  .pj-media__wrap { display: grid; grid-template-columns: minmax(0, 420px) 1fr; gap: var(--space-5); align-items: start; }
  .pj-play {
    position: relative; display: block; width: 100%; padding: 0; cursor: pointer;
    aspect-ratio: 9 / 16; overflow: hidden;
    border-radius: var(--radius-large); border: 1px solid var(--white-10);
    background: #141010;
  }
  .pj-play img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pj-play__btn {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 72px; height: 72px; border-radius: 50%;
    background: var(--color-red); color: var(--color-white);
    display: grid; place-items: center;
    transition: transform 0.25s var(--ease);
  }
  .pj-play:hover .pj-play__btn { transform: translate(-50%, -50%) scale(1.07); }
  .pj-play:focus-visible { box-shadow: var(--focus-ring); }

  .pj-h { margin-top: var(--space-4); }
  .pj-text { margin-top: 8px; line-height: 1.85; color: var(--white-70); max-width: 52ch; }
  .pj-cta { margin-top: var(--space-4); }

  .pj-more__t { margin-top: var(--space-4); }
  .pj-more__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 16px; max-width: 760px; }
  .pj-more__card { display: flex; flex-direction: column; gap: 8px; font-weight: 600; font-size: var(--text-xs); }
  .pj-more__card img { aspect-ratio: 9 / 16; object-fit: cover; border-radius: var(--radius-medium); border: 1px solid var(--white-08); transition: transform 0.4s var(--ease); }
  .pj-more__card:hover img { transform: translateY(-4px); }

  @media (max-width: 820px) {
    .pj-media__wrap { grid-template-columns: 1fr; }
    .pj-play { max-width: 380px; }
    .pj-more__grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
