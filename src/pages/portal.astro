---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PortalCalendar from '../components/PortalCalendar.astro';
import { portalPage, portalIntro, whatsappLink } from '../config';
---
<Base
  title="Client Portal — Next Level"
  description="نظرة على Client Portal القادم من Next Level: رزنامة المحتوى، الـ scripts، المواعيد، الموافقات وحالة كل content في بلاصة وحدة. Demo بمحتوى تجريبي."
>
  <Nav current="/portal" />

  <main id="main-content">
    <section class="section pt-hero">
      <div class="container">
        <p class="meta"><span class="accent">●</span> Client Portal — <span class="latin">{portalIntro.soon}</span></p>
        <h1 class="h-hero">{portalPage.title}</h1>
        <p class="lead">{portalPage.sub}</p>
      </div>
    </section>

    <section class="section--sm">
      <div class="container">
        <PortalCalendar expanded />
      </div>
    </section>

    <section class="section--sm">
      <div class="container">
        <div class="sindex"><b>·</b> شنوّة يعطيك</div>
        <div class="pt-benefits">
          {portalPage.benefits.map((b, i) => (
            <div class="pt-benefit">
              <span class="latin">0{i + 1}</span>
              <h2>{b.t}</h2>
              <p>{b.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section--sm pt-cta">
      <div class="container">
        <hr class="rule" />
        <div class="pt-cta__row">
          <div>
            <p class="pt-cta__soon latin">{portalIntro.soon}</p>
            <p class="h-display">{portalIntro.soonLine}</p>
          </div>
          <a href={whatsappLink('السلام عليكم Next Level 👋 نحب نحكي على شراكة إنتاج.')} target="_blank" rel="noopener" class="btn btn--solid btn--lg">
            {portalPage.cta}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .pt-hero { padding-top: clamp(140px, 20vh, 220px); padding-bottom: var(--space-4); }
  .pt-hero h1 { margin-top: 16px; }
  .pt-hero .lead { margin-top: 18px; }

  .pt-benefits { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .pt-benefit { border-top: 1px solid var(--white-10); padding-top: 16px; }
  .pt-benefit span { font-size: var(--text-xs); font-weight: 600; color: var(--color-red); letter-spacing: 0.14em; }
  .pt-benefit h2 { margin-top: 10px; font-size: var(--text-lg); font-weight: 700; }
  .pt-benefit p { margin-top: 8px; color: var(--white-70); font-size: var(--text-sm); line-height: 1.75; }

  .pt-cta__row { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; padding-top: var(--space-5); flex-wrap: wrap; }
  .pt-cta__soon { font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-red); margin-bottom: 10px; }
  .pt-cta__row .h-display { max-width: 22ch; }

  @media (max-width: 900px) { .pt-benefits { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .pt-benefits { grid-template-columns: 1fr; } }
</style>
