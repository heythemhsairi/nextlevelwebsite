---
/* Primary CTA — routes to the booking page (or external calendar if set in config). */
import { site } from '../config';
interface Props { label: string; class?: string; }
const { label, class: cls = 'btn btn--solid' } = Astro.props;
const href = site.bookingUrl || '/book';
const external = Boolean(site.bookingUrl);
---
<a
  href={href}
  class={cls}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  {label} <span class="arrow" aria-hidden="true">←</span>
</a>
