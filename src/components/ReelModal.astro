---
/* Video dialog — native <dialog> + shared .mshell centering, opened by any
   [data-reel] trigger. Triggers may set data-reel-ar="portrait|landscape"
   (site.js copies it to data-ar here) so the frame is sized before metadata
   loads. Native dialog gives focus trap, Escape and ::backdrop for free. */
---
<dialog class="reel mshell" id="reelModal" aria-label="مشغّل الفيديو" data-ar="landscape">
  <div class="reel__box">
    <button class="reel__close" aria-label="إغلاق">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <video controls playsinline preload="metadata"></video>
  </div>
</dialog>

<style>
  /* orientation-aware frame widths (shell provides centering + max bounds) */
  .reel[data-ar="landscape"] { width: min(1200px, calc(100dvw - 32px)); }
  .reel[data-ar="portrait"]  { width: min(440px, calc(100dvw - 32px)); }

  .reel__box {
    position: relative; overflow: hidden;
    border-radius: clamp(14px, 1.5vw, 24px);
    border: 1px solid var(--white-16);
    background: #000;
    box-shadow: 0 30px 100px rgba(0, 0, 0, 0.55);
  }
  .reel__box video {
    display: block; width: 100%;
    max-height: calc(100dvh - 48px);
    object-fit: contain;           /* never crop portrait into landscape */
    background: #000;
  }
  .reel[data-ar="landscape"] video { aspect-ratio: 16 / 9; }
  .reel[data-ar="portrait"] video  { aspect-ratio: 9 / 16; }

  .reel__close {
    position: absolute; inset-block-start: 12px; inset-inline-end: 12px; z-index: 3;
    width: 44px; height: 44px; display: grid; place-items: center;
    background: var(--black-72); color: var(--color-white);
    border: 1px solid var(--white-16); border-radius: var(--radius-small);
    cursor: pointer; transition: color 0.2s, border-color 0.2s;
  }
  .reel__close:hover { color: var(--color-red); border-color: var(--color-red); }
</style>
