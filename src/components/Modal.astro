---
// Video modal, opened by any element carrying [data-video].
---
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal__box">
    <button class="modal__close" id="modalClose" aria-label="close">×</button>
    <div class="modal__media" id="modalMedia">
      <video id="modalPlayer" controls playsinline preload="metadata"></video>
    </div>
    <h3 id="modalTitle" class="latin">Showreel</h3>
    <p id="modalDesc">شوف كيفاش Next Level تخرّج expertise حقيقية في صورة أقوى وأهدى.</p>
    <a href="/book" class="btn btn--solid">احجز مكالمة خاصة ←</a>
  </div>
</div>

<style>
  .modal {
    position: fixed; inset: 0; z-index: 90; background: rgba(0,0,0,.9);
    backdrop-filter: blur(8px); display: grid; place-items: center; padding: 20px;
    opacity: 0; pointer-events: none; transition: opacity .25s var(--ease);
  }
  .modal.open { opacity: 1; pointer-events: auto; }
  .modal__box {
    position: relative;
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--line-2); border-radius: var(--radius-lg); width: min(980px, 100%);
    padding: 22px 22px 28px; text-align: center; transform: scale(.98); transition: transform .3s var(--ease);
    box-shadow: 0 40px 90px -30px rgba(224,165,74,.5), 0 0 0 1px rgba(224,165,74,.08);
  }
  .modal.open .modal__box { transform: scale(1); }
  .modal__media {
    aspect-ratio: 16 / 9; border-radius: 18px; overflow: hidden; background: #070707;
    border: 1px solid var(--line); margin-bottom: 18px;
  }
  .modal__media video { width: 100%; height: 100%; object-fit: cover; background: #070707; }
  .modal__box h3 { font-family: var(--font-display); font-weight: 800; font-size: 26px; margin-bottom: 6px; }
  .modal__box p { color: var(--dim); margin-bottom: 24px; }
  .modal__close {
    position: absolute; top: 18px; inset-inline-end: 18px; width: 42px; height: 42px; border-radius: 50%;
    background: rgba(12,11,12,.9); border: 1px solid var(--line-2); color: var(--white);
    font-size: 22px; cursor: pointer; transition: .2s;
  }
  .modal__close:hover { border-color: var(--red); color: var(--red); }

  @media (max-width: 720px) {
    .modal__box { padding: 18px 18px 24px; }
    .modal__box h3 { font-size: 22px; }
  }
</style>
