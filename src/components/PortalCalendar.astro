---
/* Portal calendar demo — dark glass, fictional content, clearly labelled demo.
   Clicking a post opens the shared #postDialog (controller in site.js).
   `expanded` = /portal variant (taller cells, activity rail visible on desktop). */
import { demoMonth, statusLabels, postFieldLabels, portalIntro, type DemoPost } from '../config';
interface Props { expanded?: boolean; }
const { expanded = false } = Astro.props;

const dayNames = ['سبت', 'أحد', 'اثنين', 'ثلاثاء', 'أربعاء', 'خميس', 'جمعة'];
const cells: ({ day: number; post?: DemoPost } | null)[] = [];
for (let i = 0; i < demoMonth.startOffset; i++) cells.push(null);
for (let d = 1; d <= demoMonth.daysInMonth; d++) {
  cells.push({ day: d, post: demoMonth.posts.find((p) => p.day === d) });
}
const done = demoMonth.posts.filter((p) => p.status === 'published' || p.status === 'scheduled').length;
const progress = Math.round((done / demoMonth.posts.length) * 100);
---
<div class={`cal glass ${expanded ? 'cal--xl' : ''}`}>
  <div class="cal__bar">
    <div class="cal__head">
      <span class="cal__month">{demoMonth.label}</span>
      <span class="cal__client">{demoMonth.clientLabel}</span>
    </div>
    <span class="cal__demo latin" aria-label="محتوى تجريبي">{portalIntro.demoBadge}</span>
  </div>

  <div class="cal__progress" role="img" aria-label={`تقدم الشهر: ${progress}%`}>
    <span class="cal__progress-label"><b class="latin">{progress}%</b> من خطة الشهر جاهزة أو منشورة</span>
    <span class="cal__track" aria-hidden="true"><span class="cal__fill" style={`width:${progress}%`}></span></span>
  </div>

  <div class="cal__grid" role="grid" aria-label="رزنامة المحتوى الشهرية — عرض تجريبي">
    <div class="cal__row cal__row--head" role="row">
      {dayNames.map((d) => <span class="cal__dayname" role="columnheader">{d}</span>)}
    </div>
    <div class="cal__days" role="rowgroup">
      {cells.map((c) =>
        c === null ? (
          <span class="cal__cell cal__cell--pad" aria-hidden="true"></span>
        ) : c.post ? (
          <button
            type="button"
            class="cal__cell cal__cell--post"
            data-post
            data-post-title={c.post.title}
            data-post-platform={c.post.platform}
            data-post-format={c.post.format}
            data-post-status={c.post.status}
            data-post-status-label={statusLabels[c.post.status]}
            data-post-deadline={`${c.post.deadline} ${demoMonth.label.split(' ')[0]}`}
            data-post-stage={c.post.stage}
            aria-label={`يوم ${c.day}: ${c.post.title} — ${statusLabels[c.post.status]}`}
          >
            <span class="cal__num latin">{c.day}</span>
            <span class="cal__dot" data-status={c.post.status} aria-hidden="true"></span>
            <span class="cal__ptitle">{c.post.shortTitle}</span>
            <span class="cal__pstatus" data-status={c.post.status}>{statusLabels[c.post.status]}</span>
          </button>
        ) : (
          <span class="cal__cell" role="gridcell" aria-label={`يوم ${c.day} — فارغ`}>
            <span class="cal__num latin">{c.day}</span>
          </span>
        ),
      )}
    </div>
  </div>

  <!-- mobile agenda view — same posts, same dialog; grid is desktop-only -->
  <ol class="cal__agenda" aria-label="خطة الشهر — عرض قائمة">
    {demoMonth.posts.map((p) => (
      <li>
        <button
          type="button"
          class="cal__arow"
          data-post
          data-post-title={p.title}
          data-post-platform={p.platform}
          data-post-format={p.format}
          data-post-status={p.status}
          data-post-status-label={statusLabels[p.status]}
          data-post-deadline={`${p.deadline} ${demoMonth.label.split(' ')[0]}`}
          data-post-stage={p.stage}
        >
          <span class="cal__aday latin">{String(p.day).padStart(2, '0')}</span>
          <span class="cal__abody">
            <span class="cal__atitle">{p.shortTitle}</span>
            <span class="cal__astatus"><i class="cal__dot" data-status={p.status} aria-hidden="true"></i>{statusLabels[p.status]}</span>
          </span>
        </button>
      </li>
    ))}
  </ol>

  <div class="cal__legend" aria-hidden="true">
    {(Object.keys(statusLabels) as (keyof typeof statusLabels)[]).map((k) => (
      <span class="cal__lg"><i class="cal__dot" data-status={k}></i>{statusLabels[k]}</span>
    ))}
  </div>
</div>

<!-- shared post detail dialog -->
<dialog class="pd glass mshell" id="postDialog" aria-labelledby="pdTitle">
  <button class="pd__close" aria-label="إغلاق">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <p class="pd__demo latin">{portalIntro.demoBadge}</p>
  <h3 class="pd__title" id="pdTitle" data-f="title"></h3>
  <dl class="pd__meta">
    <div><dt>{postFieldLabels.platform}</dt><dd class="latin" data-f="platform"></dd></div>
    <div><dt>{postFieldLabels.format}</dt><dd class="latin" data-f="format"></dd></div>
    <div><dt>{postFieldLabels.date}</dt><dd data-f="deadline"></dd></div>
    <div><dt>{postFieldLabels.status}</dt><dd><span class="pd__status" data-f="status"></span></dd></div>
  </dl>
  <p class="pd__stage-label">{postFieldLabels.stage}</p>
  <p class="pd__stage" data-f="stage"></p>
</dialog>

<style>
  .cal { border-radius: var(--radius-large); padding: clamp(16px, 3vw, 28px); }

  .cal__bar { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
  .cal__head { display: flex; flex-direction: column; gap: 2px; }
  .cal__month { font-weight: 700; font-size: var(--text-lg); }
  .cal__client { color: var(--white-55); font-size: var(--text-xs); }
  .cal__demo {
    font-size: 11px; font-weight: 600; letter-spacing: 0.08em;
    padding: 6px 12px; border: 1px solid var(--red-40); color: var(--color-red);
    border-radius: var(--radius-small); background: var(--red-12); white-space: nowrap;
  }

  .cal__progress { margin-top: 18px; display: flex; flex-direction: column; gap: 8px; }
  .cal__progress-label { font-size: var(--text-xs); color: var(--white-70); }
  .cal__progress-label b { color: var(--color-white); }
  .cal__track { height: 4px; background: var(--white-08); border-radius: 2px; overflow: hidden; }
  .cal__fill { display: block; height: 100%; background: var(--color-red); border-radius: 2px; }

  .cal__grid { margin-top: 20px; }
  .cal__row--head, .cal__days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
  .cal__dayname {
    font-size: 11px; color: var(--white-55); text-align: center; padding-block: 6px;
    font-weight: 500;
  }
  .cal__days { margin-top: 4px; }
  .cal__cell {
    min-height: 58px; min-width: 0; border-radius: var(--radius-small);
    border: 1px solid var(--white-05); background: rgba(10, 8, 8, 0.3);
    padding: 6px; display: flex; flex-direction: column; gap: 3px; align-items: flex-start;
    font: inherit; color: inherit; text-align: start; position: relative;
  }
  .cal--xl .cal__cell { min-height: 76px; }
  .cal__cell--pad { border-color: transparent; background: transparent; }
  .cal__num { font-size: 11px; color: var(--white-55); }
  .cal__cell--post { cursor: pointer; border-color: var(--white-10); transition: border-color 0.2s, background 0.2s; }
  .cal__cell--post:hover { border-color: var(--red-40); background: rgba(230, 51, 41, 0.06); }
  .cal__ptitle {
    font-size: 11px; font-weight: 600; line-height: 1.4; color: var(--color-white);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .cal__pstatus { display: none; font-size: 10px; color: var(--white-55); }
  .cal--xl .cal__pstatus { display: block; }

  /* status dot — color + text pair (never color alone: label lives in aria + dialog) */
  .cal__dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; flex: none; }
  .cal__dot[data-status="published"] { background: var(--color-white); }
  .cal__dot[data-status="scheduled"] { background: var(--white-70); }
  .cal__dot[data-status="approval"] { background: var(--color-red); }
  .cal__dot[data-status="editing"] { background: var(--red-40); border: 1px solid var(--color-red); }
  .cal__dot[data-status="shoot"] { background: transparent; border: 1.5px solid var(--color-red); }
  .cal__dot[data-status="script"] { background: transparent; border: 1.5px solid var(--white-70); }
  .cal__dot[data-status="idea"] { background: transparent; border: 1.5px dashed var(--white-40); }

  .cal__legend { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 18px; }
  .cal__lg { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--white-55); }

  /* ---- post dialog ---- */
  /* centering + backdrop come from the shared .mshell shell */
  .pd {
    border: 1px solid var(--white-16); border-radius: var(--radius-large);
    padding: clamp(20px, 4vw, 32px);
    width: min(560px, calc(100dvw - 32px));
    max-height: min(760px, calc(100dvh - 32px));
    overflow: auto;
    color: var(--color-white);
  }
  .pd__close {
    position: absolute; top: 14px; inset-inline-end: 14px;
    width: 44px; height: 44px; display: grid; place-items: center;
    border: 1px solid var(--white-10); border-radius: var(--radius-small);
    color: var(--color-white); cursor: pointer;
  }
  .pd__close:hover { color: var(--color-red); border-color: var(--color-red); }
  .pd__demo { font-size: 11px; color: var(--color-red); letter-spacing: 0.08em; margin-bottom: 10px; }
  .pd__title { font-size: var(--text-xl); font-weight: 700; line-height: 1.35; padding-inline-end: 44px; }
  .pd__meta { margin-top: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pd__meta dt { font-size: 11px; color: var(--white-55); margin-bottom: 2px; }
  .pd__meta dd { font-weight: 600; font-size: var(--text-sm); }
  .pd__status { color: var(--color-red); }
  .pd__stage-label { margin-top: 20px; font-size: 11px; color: var(--white-55); }
  .pd__stage { margin-top: 4px; font-size: var(--text-sm); color: var(--white-70); line-height: 1.7; }

  /* ---- mobile agenda (44px targets — 7-col grid can't honor that under ~640px) ---- */
  .cal__agenda { display: none; margin-top: 20px; flex-direction: column; }
  .cal__arow {
    width: 100%; display: flex; align-items: center; gap: 14px;
    min-height: 56px; padding: 10px 4px; text-align: start;
    border: 0; border-bottom: 1px solid var(--white-08);
    font: inherit; color: inherit; cursor: pointer;
    transition: background 0.2s;
  }
  .cal__arow:hover { background: var(--white-05); }
  .cal__aday {
    font-size: var(--text-xs); font-weight: 600; color: var(--color-red);
    min-width: 26px;
  }
  .cal__abody { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .cal__atitle { font-size: var(--text-sm); font-weight: 600; color: var(--color-white); }
  .cal__astatus { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--white-55); }

  @media (max-width: 640px) {
    .cal__grid { display: none; }
    .cal__agenda { display: flex; }
  }
</style>
