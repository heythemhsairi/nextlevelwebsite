---
import { nav, CTA } from '../config';
interface Props { current?: string; }
const { current = '/' } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---
<header class="nav" id="nav">
  <div class="nav__inner">
    <a href="/" class="nav__logo" aria-label="Next Level — الرئيسية">
      <img src="/brand/next-full.svg" alt="" width="164" height="27" />
    </a>

    <nav class="nav__links" aria-label="التنقل الرئيسي">
      {nav.map((item) => (
        <a href={item.href} class={isActive(item.href) ? 'active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="nav__end">
      <a href="/book" class="btn btn--solid nav__book">{CTA.primary}</a>
      <button class="burger" id="burger" aria-label="القائمة" aria-controls="drawer" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Closed by default: inert + aria-hidden keep it out of the a11y tree and
     tab order until site.js opens it. Both toggle together on open/close. -->
<nav class="drawer" id="drawer" aria-label="القائمة" aria-hidden="true" inert>
  <ol class="drawer__list">
    {nav.map((item, i) => (
      <li>
        <span class="drawer__n latin">0{i + 1}</span>
        <a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.label}</a>
      </li>
    ))}
  </ol>
  <a href="/book" class="btn btn--solid btn--lg drawer__book">{CTA.primary}</a>
</nav>

<style>
  .nav {
    position: fixed; top: 0; inset-inline: 0; z-index: 100;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .nav.scrolled {
    background: rgba(10, 8, 8, 0.72);
    border-color: var(--white-08);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .nav__inner {
    max-width: var(--maxw); margin-inline: auto; padding-inline: var(--gutter);
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    height: 76px;
  }
  .nav__logo { flex: none; display: inline-flex; align-items: center; min-height: 44px; }
  .nav__logo img { height: 22px; width: auto; }

  .nav__links { display: flex; align-items: center; gap: 6px; }
  .nav__links a {
    font-weight: 500; font-size: var(--text-sm); color: var(--white-70);
    padding: 10px 14px; min-height: 44px; display: inline-flex; align-items: center;
    border-radius: var(--radius-small);
    transition: color 0.2s;
  }
  .nav__links a:hover { color: var(--color-white); }
  .nav__links a.active { color: var(--color-white); }
  .nav__links a.active::after {
    content: ''; position: absolute; display: none;
  }
  .nav__links a.active { box-shadow: inset 0 -2px 0 var(--color-red); border-radius: 0; }

  .nav__end { display: flex; align-items: center; gap: 12px; }
  .nav__book { min-height: 44px; padding: 10px 20px; font-size: var(--text-xs); }

  .burger {
    display: none; flex-direction: column; align-items: center; justify-content: center;
    gap: 6px; width: 44px; height: 44px; flex: none; padding: 0;
  }
  .burger span { width: 24px; height: 2px; background: var(--color-white); transition: 0.3s var(--ease); }
  .burger.open span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .burger.open span:nth-child(2) { opacity: 0; }
  .burger.open span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  /* ---- drawer ---- */
  .drawer {
    position: fixed; inset: 0; z-index: 99;
    background: var(--color-black);
    display: flex; flex-direction: column; justify-content: center;
    padding: 96px var(--gutter) 40px;
    overflow-y: auto; overscroll-behavior: contain;
    opacity: 0; pointer-events: none; transition: opacity 0.3s var(--ease);
  }
  .drawer.open { opacity: 1; pointer-events: auto; }
  .drawer__list { display: flex; flex-direction: column; }
  .drawer__list li {
    display: flex; align-items: baseline; gap: 18px;
    border-top: 1px solid var(--white-08); padding-block: 6px;
  }
  .drawer__list li:last-child { border-bottom: 1px solid var(--white-08); }
  .drawer__n { font-family: var(--font-latin); font-size: var(--text-xs); color: var(--color-red); font-weight: 600; }
  .drawer__list a {
    font-weight: 700; font-size: var(--text-2xl); color: var(--white-70);
    padding: 10px 0; min-height: 44px; display: inline-flex; align-items: center; flex: 1;
  }
  .drawer__list a:hover, .drawer__list a.active { color: var(--color-white); }
  .drawer__book { margin-top: var(--space-5); align-self: flex-start; }

  @media (max-width: 900px) {
    .nav__links, .nav__book { display: none; }
    .burger { display: flex; }
  }
</style>
