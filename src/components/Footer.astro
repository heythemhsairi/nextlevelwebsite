---
import { site, nav, whatsappLink, hasRealWhatsapp, hasRealSocials } from '../config';
const year = new Date().getFullYear();
const socials = [
  hasRealSocials.instagram && { label: 'Instagram', href: site.socials.instagram },
  hasRealSocials.tiktok && { label: 'TikTok', href: site.socials.tiktok },
  hasRealSocials.youtube && { label: 'YouTube', href: site.socials.youtube },
].filter(Boolean) as { label: string; href: string }[];
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <img src="/brand/next-full.svg" alt="Next Level" width="220" height="36" class="footer__logo" />
        <p class="footer__line">Media Production House — Tunisia</p>
      </div>

      <nav class="footer__nav" aria-label="روابط الموقع">
        {nav.map((i) => <a href={i.href}>{i.label}</a>)}
        <a href="/book">احجز مكالمة</a>
      </nav>

      <div class="footer__contact">
        {hasRealWhatsapp && (
          <a href={whatsappLink()} target="_blank" rel="noopener" class="footer__wa latin" dir="ltr">
            {site.whatsappDisplay}
          </a>
        )}
        {socials.length > 0 && (
          <div class="footer__social">
            {socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
          </div>
        )}
      </div>
    </div>

    <div class="footer__bar">
      <small class="latin">© {year} {site.domain} — All rights reserved</small>
      <span class="meta">Tunis, TN</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--color-black); border-top: 1px solid var(--white-08); padding-top: var(--space-6); }
  .footer__top {
    display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: var(--space-5);
    padding-bottom: var(--space-5); border-bottom: 1px solid var(--white-08);
    align-items: start;
  }
  .footer__logo { height: 26px; width: auto; }
  .footer__line { margin-top: 16px; color: var(--white-55); font-family: var(--font-latin); font-size: var(--text-xs); letter-spacing: 0.14em; text-transform: uppercase; }

  .footer__nav { display: flex; flex-direction: column; align-items: flex-start; }
  .footer__nav a {
    color: var(--white-70); font-weight: 500; font-size: var(--text-sm);
    min-height: 44px; display: inline-flex; align-items: center;
    transition: color 0.2s;
  }
  .footer__nav a:hover { color: var(--color-red); }

  .footer__contact { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .footer__wa {
    color: var(--color-white); font-weight: 600; font-size: var(--text-lg);
    min-height: 44px; display: inline-flex; align-items: center;
  }
  .footer__wa:hover { color: var(--color-red); }
  .footer__social { display: flex; gap: 4px; flex-wrap: wrap; }
  .footer__social a {
    color: var(--white-55); font-family: var(--font-latin); font-size: var(--text-xs);
    letter-spacing: 0.1em; text-transform: uppercase;
    min-height: 44px; min-width: 44px; display: inline-flex; align-items: center;
  }
  .footer__social a:hover { color: var(--color-white); }

  .footer__bar {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    padding-block: 24px; flex-wrap: wrap;
  }
  .footer__bar small { color: var(--white-55); font-size: var(--text-xs); }

  @media (max-width: 760px) {
    .footer__top { grid-template-columns: 1fr; gap: var(--space-4); }
  }
</style>
