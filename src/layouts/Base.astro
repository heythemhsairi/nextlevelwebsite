---
import '../styles/global.css';
import { site, hasRealSocials, hasRealWhatsapp } from '../config';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const origin = (Astro.site ?? new URL('https://nextlevel.tn')).origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL('/og.png', origin).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: origin,
  description,
  ...(Object.values(hasRealSocials).some(Boolean)
    ? {
        sameAs: [
          hasRealSocials.instagram ? site.socials.instagram : null,
          hasRealSocials.tiktok ? site.socials.tiktok : null,
          hasRealSocials.youtube ? site.socials.youtube : null,
        ].filter(Boolean),
      }
    : {}),
  ...(hasRealWhatsapp
    ? {
        contactPoint: {
          '@type': 'ContactPoint',
          contactType: 'sales',
          telephone: '+216-27-391-176',
          url: `https://wa.me/${site.whatsapp}`,
          areaServed: 'TN',
          availableLanguage: ['ar', 'fr', 'en'],
        },
      }
    : {}),
};
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph / social sharing -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="ar_TN" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#0A0808" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Thmanyah Sans self-hosted (client-supplied) — preload the two critical
       weights; Inter (Latin labels) stays on Google Fonts -->
  <link rel="preload" href="/fonts/thmanyah-sans-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/thmanyah-sans-700.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <!-- masked-reveal typography only activates when JS is present;
       without JS, headlines render as plain visible text -->
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a href="#main-content" class="skip-link">تخطّى إلى المحتوى</a>
  <slot />
  <script src="/site.js" is:inline defer></script>
</body>
</html>
